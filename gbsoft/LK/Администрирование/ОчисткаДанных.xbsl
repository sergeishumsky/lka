импорт gbsoft::LK::Основное

метод НайтиПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Подтверждение = Ложь
    Файлы.Очистить()
    НачалоАнализа = Неопределено
    КонецАнализа = Неопределено
    если НачалоПериода == Неопределено или КонецПериода == Неопределено
        Сообщение = "Укажите начало и конец периода."
        возврат
    ;
    знч Начало = НачалоПериода!
    знч Конец = КонецПериода!
    если Начало > Конец
        Сообщение = "Начало периода позже окончания."
        возврат
    ;
    Файлы = ОчисткаФайловСервер.НайтиФайлы(Начало, Конец)
    НачалоАнализа = Начало
    КонецАнализа = Конец
    Сообщение = "Найдено вложений: %{Файлы.Размер()}"
;

метод ОчиститьПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    если не Подтверждение или НачалоАнализа == Неопределено или КонецАнализа == Неопределено или Файлы.Размер() == 0
        Сообщение = "Сначала найдите файлы и подтвердите очистку."
        возврат
    ;
    если НачалоПериода != НачалоАнализа или КонецПериода != КонецАнализа
        Подтверждение = Ложь
        Сообщение = "Период изменился. Повторите поиск."
        возврат
    ;
    знч Количество = ОчисткаФайловСервер.ОчиститьФайлы(НачалоАнализа!, КонецАнализа!, Файлы)
    Файлы.Очистить()
    Подтверждение = Ложь
    НачалоАнализа = Неопределено
    КонецАнализа = Неопределено
    Сообщение = "Удалено вложений: %{Количество}. При наличии других ссылок файл сохраняется в хранилище."
;
