импорт gbsoft::LK::Основное

метод НайтиПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Подтверждение = Ложь
    Файлы.Очистить()
    ОбщийРазмерБайтов = 0
    НачалоАнализа = Неопределено
    КонецАнализа = Неопределено
    ОбработаноДокументов = 0
    ЕстьЕще = Ложь
    если НачалоПериода == Неопределено или КонецПериода == Неопределено
        Сообщение = "Укажите начало и конец периода."
        возврат
    ;
    знч Начало = НачалоПериода!
    знч Конец = КонецПериода!
    если Начало > Конец
        Сообщение = "Начало периода позже окончания."
        возврат
    ;
    НачалоАнализа = Начало
    КонецАнализа = Конец
    ЕстьЕще = Истина
    ЗагрузитьСледующуюПорцию()
;

метод СледующиеПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    если не ЕстьЕще или НачалоАнализа == Неопределено или КонецАнализа == Неопределено
        возврат
    ;
    если НачалоПериода != НачалоАнализа или КонецПериода != КонецАнализа
        Подтверждение = Ложь
        Сообщение = "Период изменился. Повторите поиск."
        возврат
    ;
    ЗагрузитьСледующуюПорцию()
;

метод ЗагрузитьСледующуюПорцию()
    знч Порция = ОчисткаФайловСервер.НайтиФайлы(НачалоАнализа!, КонецАнализа!, ОбработаноДокументов)
    знч ВсеФайлы = новый Массив<ФайлДляОчистки>(Файлы)
    для Файл из Порция.Файлы
        ВсеФайлы.Добавить(Файл)
    ;
    // Сортировка применяется ко всем уже загруженным файлам.
    Файлы = ВсеФайлы.СортироватьПо(Файл -> -Файл.Размер)
    пер РазмерПорцииБайтов = 0
    для Файл из Порция.Файлы
        РазмерПорцииБайтов = РазмерПорцииБайтов + Файл.Размер
    ;
    ОбщийРазмерБайтов = ОбщийРазмерБайтов + РазмерПорцииБайтов
    ОбработаноДокументов = ОбработаноДокументов + Порция.КоличествоДокументов
    ЕстьЕще = Порция.КоличествоДокументов == 100
    Подтверждение = Ложь
    если ЕстьЕще
        Сообщение = "Проверено рекламаций: %{ОбработаноДокументов}. Найдено вложений: %{Файлы.Размер()}. Для продолжения нажмите «Следующие 100 рекламаций»."
    иначе
        Сообщение = "Поиск завершён. Проверено рекламаций: %{ОбработаноДокументов}. Найдено вложений: %{Файлы.Размер()}."
    ;
;

метод ОчиститьПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    если не Подтверждение или НачалоАнализа == Неопределено или КонецАнализа == Неопределено или Файлы.Размер() == 0
        Сообщение = "Сначала найдите файлы и подтвердите очистку."
        возврат
    ;
    если НачалоПериода != НачалоАнализа или КонецПериода != КонецАнализа
        Подтверждение = Ложь
        Сообщение = "Период изменился. Повторите поиск."
        возврат
    ;
    знч Количество = ОчисткаФайловСервер.ОчиститьФайлы(НачалоАнализа!, КонецАнализа!, Файлы)
    Файлы.Очистить()
    ОбщийРазмерБайтов = 0
    Подтверждение = Ложь
    НачалоАнализа = Неопределено
    КонецАнализа = Неопределено
    ЕстьЕще = Ложь
    ОбработаноДокументов = 0
    Сообщение = "Удалено вложений: %{Количество}. При наличии других ссылок файл сохраняется в хранилище."
;
