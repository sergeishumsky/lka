импорт gbsoft::LK::Основное

метод НайтиПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    если ВыполняетсяОчистка
        возврат
    ;
    Подтверждение = Ложь
    ПодтверждениеВсех = Ложь
    Файлы.Очистить()
    НачалоАнализа = Неопределено
    КонецАнализа = Неопределено
    ОбработаноДокументов = 0
    ВсегоРекламаций = 0
    ЕстьЕще = Ложь
    если НачалоПериода == Неопределено или КонецПериода == Неопределено
        Сообщение = "Укажите начало и конец периода."
        возврат
    ;
    знч Начало = НачалоПериода!
    знч Конец = КонецПериода!
    если Начало > Конец
        Сообщение = "Начало периода позже окончания."
        возврат
    ;
    ВсегоРекламаций = ОчисткаФайловСервер.КоличествоРекламаций(Начало, Конец)
    НачалоАнализа = Начало
    КонецАнализа = Конец
    ЕстьЕще = Истина
    ЗагрузитьСледующуюПорцию()
;

метод СледующиеПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    если ВыполняетсяОчистка
        возврат
    ;
    если не ЕстьЕще или НачалоАнализа == Неопределено или КонецАнализа == Неопределено
        возврат
    ;
    если НачалоПериода != НачалоАнализа или КонецПериода != КонецАнализа
        Подтверждение = Ложь
        ПодтверждениеВсех = Ложь
        Сообщение = "Период изменился. Повторите поиск."
        возврат
    ;
    ЗагрузитьСледующуюПорцию()
;

метод ЗагрузитьСледующуюПорцию()
    знч Порция = ОчисткаФайловСервер.НайтиФайлы(НачалоАнализа!, КонецАнализа!, ОбработаноДокументов)
    знч ВсеФайлы = новый Массив<ФайлДляОчистки>(Файлы)
    для Файл из Порция.Файлы
        ВсеФайлы.Добавить(Файл)
    ;
    // Сортировка применяется ко всем уже загруженным файлам.
    Файлы = ВсеФайлы.СортироватьПо(Файл -> -Файл.Размер)
    ОбработаноДокументов = ОбработаноДокументов + Порция.КоличествоДокументов
    ЕстьЕще = Порция.КоличествоДокументов == 100 и ОбработаноДокументов < ВсегоРекламаций
    Подтверждение = Ложь
    ПодтверждениеВсех = Ложь
    если ЕстьЕще
        Сообщение = "Проверено рекламаций: %{ОбработаноДокументов}. Найдено вложений: %{Файлы.Размер()}. Для продолжения нажмите «Следующие 100 рекламаций»."
    иначе
        Сообщение = "Поиск завершён. Проверено рекламаций: %{ОбработаноДокументов}. Найдено вложений: %{Файлы.Размер()}."
    ;
;

метод ОчиститьПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    если ВыполняетсяОчистка
        возврат
    ;
    если не Подтверждение или НачалоАнализа == Неопределено или КонецАнализа == Неопределено или Файлы.Размер() == 0
        Сообщение = "Сначала найдите файлы и подтвердите очистку."
        возврат
    ;
    если НачалоПериода != НачалоАнализа или КонецПериода != КонецАнализа
        Подтверждение = Ложь
        ПодтверждениеВсех = Ложь
        Сообщение = "Период изменился. Повторите поиск."
        возврат
    ;
    пер Количество = 0
    ВыполняетсяОчистка = Истина
    попытка
        Количество = ОчисткаФайловСервер.ОчиститьФайлы(НачалоАнализа!, КонецАнализа!, Файлы)
    вконце
        ВыполняетсяОчистка = Ложь
    ;
    Файлы.Очистить()
    Подтверждение = Ложь
    ПодтверждениеВсех = Ложь
    НачалоАнализа = Неопределено
    КонецАнализа = Неопределено
    ЕстьЕще = Ложь
    ОбработаноДокументов = 0
    Сообщение = "Удалено вложений: %{Количество}. При наличии других ссылок файл сохраняется в хранилище."
;

метод ПолучитьОбщийОбъемМБ(): Число
    пер РазмерБайтов = 0
    для Файл из Файлы
        РазмерБайтов = РазмерБайтов + Файл.Размер
    ;
    возврат (РазмерБайтов / 1048576).Округлить(2)
;

метод ТекстПодтвержденияПолнойОчистки(): Строка
    если НачалоАнализа == Неопределено или КонецАнализа == Неопределено
        возврат "Подтверждаю удаление всех вложений за период (сначала выполните поиск)"
    ;
    возврат "Подтверждаю удаление всех вложений: период с %{НачалоАнализа} по %{КонецАнализа}, статус «Отгружено», рекламаций по фильтру — %{ВсегоРекламаций}"
;

метод ОчиститьВсеПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    если ВыполняетсяОчистка
        возврат
    ;
    если не ПодтверждениеВсех или НачалоАнализа == Неопределено или КонецАнализа == Неопределено
        Сообщение = "Выполните поиск и подтвердите удаление всех вложений за период отдельным флажком."
        возврат
    ;
    если НачалоПериода != НачалоАнализа или КонецПериода != КонецАнализа
        ПодтверждениеВсех = Ложь
        Сообщение = "Период изменился. Повторите поиск."
        возврат
    ;
    знч Начало = НачалоАнализа!
    знч Конец = КонецАнализа!
    ВыполняетсяОчистка = Истина
    попытка
        знч Рекламации = ОчисткаФайловСервер.РекламацииДляОчистки(Начало, Конец)
        если Рекламации.Размер() != ВсегоРекламаций
            ВсегоРекламаций = Рекламации.Размер()
            ПодтверждениеВсех = Ложь
            Сообщение = "Количество рекламаций изменилось. Проверьте новый итог и подтвердите полную очистку повторно."
            возврат
        ;
        // Список утрачивает актуальность с начала очистки, в том числе при ошибке.
        Файлы.Очистить()
        ЕстьЕще = Ложь
        Подтверждение = Ложь
        ПодтверждениеВсех = Ложь
        НачалоАнализа = Неопределено
        КонецАнализа = Неопределено
        ОбработаноДокументов = 0
        пер Удалено = 0
        пер Индекс = 0
        пока Индекс < Рекламации.Размер()
            знч Порция = новый Массив<Рекламация.Ссылка>()
            пока Индекс < Рекламации.Размер() и Порция.Размер() < 100
                Порция.Добавить(Рекламации[Индекс])
                Индекс = Индекс + 1
            ;
            Сообщение = "Очистка за период. Обработано рекламаций: %{ОбработаноДокументов} из %{Рекламации.Размер()}. Удалено вложений: %{Удалено}."
            Удалено = Удалено + ОчисткаФайловСервер.ОчиститьПорциюРекламаций(Начало, Конец, Порция)
            ОбработаноДокументов = ОбработаноДокументов + Порция.Размер()
        ;
        Сообщение = "Очистка за период завершена. Проверено рекламаций: %{ОбработаноДокументов}. Удалено вложений: %{Удалено}. При наличии других ссылок файл сохраняется в хранилище."
    поймать Ошибка: Исключение
        Сообщение = "Полная очистка прервана. Часть вложений могла быть удалена. Повторите поиск для проверки оставшихся данных."
        выбросить Ошибка
    вконце
        ВыполняетсяОчистка = Ложь
    ;
;
