метод ТекущийМесяцПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    знч Сегодня = ДатаВремя.Сейчас().Дата
    НачальнаяДата = Сегодня.НачалоМесяца()
    КонечнаяДата = Сегодня.КонецМесяца()
    Сообщение = ""
;

метод ПрименитьПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    если НачальнаяДата == Неопределено или КонечнаяДата == Неопределено
        Сообщение = "Укажите обе даты."
        возврат
    ;
    если НачальнаяДата! > КонечнаяДата!
        Сообщение = "Начало интервала позже окончания."
        возврат
    ;
    знч Интервал = новый Массив<Дата>()
    Интервал.Добавить(НачальнаяДата!)
    Интервал.Добавить(КонечнаяДата!)
    Закрыть(Интервал)
;

метод ОтменаПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Закрыть(Неопределено)
;
