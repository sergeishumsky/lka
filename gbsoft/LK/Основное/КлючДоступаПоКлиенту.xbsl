@Обработчик
метод ПроверитьНаличиеКлючейДоступа(Ключи: ЧитаемыйМассив<КлючДоступаПоКлиенту.Объект>, ПользователиДляПроверки: ЧитаемыйМассив<Пользователи.Ссылка>): 
    ЧитаемоеСоответствие<КлючДоступаПоКлиенту.Объект, ЧитаемаяКоллекция<Пользователи.Ссылка>>
    
    знч Клиенты = <Клиенты.Ссылка>[]
    для Ключ из Ключи
        если не Ключ.Клиент == Неопределено
        
            Клиенты.Добавить(Ключ.Клиент)
            
        ;
    ;
    
    знч Пользователи = <Пользователи.Ссылка>[]
    для Пользователь из ПользователиДляПроверки
        Пользователи.Добавить(Пользователь)
    ;
    
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Сотрудники.Клиент КАК Клиент,
            Сотрудники.Пользователь КАК Пользователь
        ИЗ
            Сотрудники КАК Сотрудники
        ГДЕ
            Сотрудники.Клиент В (%Клиенты)
            И Сотрудники.Пользователь В (%Пользователи)
    }
    
    знч Сотрудники = <Клиенты.Ссылка, Массив<Пользователи.Ссылка>>{:}
    
    знч РезультатЗапроса = Запрос.Выполнить()
    
    для СтрокаРезультата из РезультатЗапроса
        Сотрудники.ВставитьЕслиОтсутствует(СтрокаРезультата.Клиент, <Пользователи.Ссылка>[])
        Сотрудники.Получить(СтрокаРезультата.Клиент).Добавить(СтрокаРезультата.Пользователь)
    ;
    
    РезультатЗапроса.Закрыть()
    
    знч Результат = <КлючДоступаПоКлиенту.Объект, Массив<Пользователи.Ссылка>>{:}
    
    для Ключ из Ключи
        знч МассивПользователей = Сотрудники.ПолучитьИлиНеопределено(Ключ.Клиент)
        если МассивПользователей != Неопределено
            Результат.Вставить(Ключ, МассивПользователей)
        ;
    ;       
    
    возврат Результат
;