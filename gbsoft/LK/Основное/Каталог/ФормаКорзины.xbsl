@Обработчик
метод ПослеСоздания()
    
    этот.Корзина = ЗаполнитьСоставКорзины()
;

@НаСервере @ДоступноСКлиента
статический метод ЗаполнитьСоставКорзины(): Массив<ДанныеСтрокиКорзины>
    
    знч Корзина = новый Массив<ДанныеСтрокиКорзины>()
    
    знч Сотрудник = ПользователиКлиентИСервер.ПолучитьТекущегоСотрудника()
    
    знч Запрос = Запрос{ВЫБРАТЬ
        Корзина.Пользователь КАК Пользователь,
        Корзина.Номенклатура КАК Номенклатура,
        Корзина.Цена КАК Цена,
        Корзина.Количество КАК Количество,
        Корзина.Сумма КАК Сумма,
        Корзина.КлючОсновногоФильтра КАК КлючОсновногоФильтра,
        Корзина.КлючЗаписи КАК КлючЗаписи
    ИЗ
        Корзина КАК Корзина
    ГДЕ 
        Корзина.Пользователь == %Сотрудник
    }
    
    пер Номер = 1
    
    для СтрокаРезультата из Запрос.Выполнить()
        Номер = Номер + 1
        Корзина.Добавить(
            новый ДанныеСтрокиКорзины(
                Номенклатура = СтрокаРезультата.Номенклатура,
                Цена = СтрокаРезультата.Цена,
                Количество = СтрокаРезультата.Количество,
                Сумма = СтрокаРезультата.Сумма,
                НомерСтроки = Номер
            )    
        )
    ;
    
    возврат Корзина
    
;