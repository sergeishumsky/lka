@Обработчик
метод ПослеСоздания()
    
        
    
;

@ВПодсистеме
метод ПолучитьПредставление(ДанныеСтроки: неизвестно): Строка?

    возврат ДанныеСтроки.Данные["Наименование"]
         + " / Артикул: "
         + ДанныеСтроки.Данные["Артикул"]
         
    
;

@ВПодсистеме
метод ПолучитьЦену(ДанныеСтроки: неизвестно): Строка?
    знч Цена = ДанныеСтроки.Данные["Цена"] как Число|Null
    возврат Цена ==  Null ? "" : Цена.Представление()
;

@ВПодсистеме
метод ПолучитьТипЦен(ДанныеСтроки: неизвестно): ТипыЦены.Ссылка?|Строка
    знч ТипЦен = ДанныеСтроки.Данные["ТипЦен"] как неизвестно
    возврат ТипЦен == Null ? "Нет цены" : ТипЦен
;


@ВПодсистеме
метод ПолучитьИзображение(ДанныеСтроки: неизвестно): ДвоичныйОбъект.Ссылка?
    знч Картинка = ДанныеСтроки.Данные["ОсновноеИзображение"] как ДвоичныйОбъект.Ссылка?
    возврат Картинка == Неопределено ? Ресурс{РесурсыКаталога/placeholder.png}.Ссылка : Картинка
;


метод ВКорзинуОбработкаНажатия(Источник: Кнопка, Событие: СобытиеПриНажатии)
    
    знч Номенклатура = ДанныеСтроки.Ключ как Номенкатура.Ссылка
    знч Цена = ДанныеСтроки.Данные["Цена"] как Число
    знч Сотрудник = ПользователиКлиентИСервер.ПолучитьТекущегоСотрудника()
    
    ДобавитьЗаписьВКорзину(Номенклатура, Сотрудник, Цена)
    
;

@НаСервере @ДоступноСКлиента
статический метод ДобавитьЗаписьВКорзину(Номенклатура: Номенкатура.Ссылка, Сотрудник: Сотрудники.Ссылка?, Цена: Число)
 
    знч Запись = новый Корзина.Запись(Номенклатура = Номенклатура, Пользователь = Сотрудник, Цена = Цена, Количество = 1, Сумма = Цена)
    Корзина.Записать(Запись)
       
;