@Обработчик
метод ПередЗаписью()
    пер ПоляНеЗаполнены: Булево
    
    если ЭтоНовый() 
    
        если Компоненты.Логин.Значение.Пусто() и Компоненты.Пользователь.Значение == Неопределено
            Компоненты.Логин.РезультатПроверкиДанных = РезультатПроверкиДанных.Ошибка
            ПоляНеЗаполнены = Истина
        иначе
            Компоненты.Логин.РезультатПроверкиДанных = РезультатПроверкиДанных.Отсутствует
        ;
        
    ;


    если Компоненты.Наименование.Значение.Пусто()
        Компоненты.Наименование.РезультатПроверкиДанных = РезультатПроверкиДанных.Ошибка
        ПоляНеЗаполнены = Истина
    иначе
        Компоненты.Наименование.РезультатПроверкиДанных = РезультатПроверкиДанных.Отсутствует
    ;
    
    если Компоненты.Роль.Значение == Неопределено
        Компоненты.Роль.РезультатПроверкиДанных = РезультатПроверкиДанных.Ошибка
        ПоляНеЗаполнены = Истина
    иначе
        Компоненты.Роль.РезультатПроверкиДанных = РезультатПроверкиДанных.Отсутствует
    ;

    если Компоненты.Клиент.Значение == Неопределено
        Компоненты.Клиент.РезультатПроверкиДанных = РезультатПроверкиДанных.Ошибка
        ПоляНеЗаполнены = Истина
    иначе
        Компоненты.Клиент.РезультатПроверкиДанных = РезультатПроверкиДанных.Отсутствует
    ;

    если ПоляНеЗаполнены
        выбросить новый ИсключениеВалидации("Не заполнены обязательные поля", ОтображатьСообщениеОбОшибке = Ложь)
    ;
    если ЭтоНовый() и Компоненты.Пользователь.Значение == Неопределено
        знч Пользователь = СоздатьПользователя(ЛогинНовогоПользователя, ЛогинНовогоПользователя)
        Объект.Пользователь = Пользователь 
    ;
;

@НаСервере @ДоступноСКлиента
статический метод СоздатьПользователя(Представление: Строка, Логин: Строка): Пользователи.Ссылка
    возврат ПользователиКлиентИСервер.СоздатьПользователя(Представление, Логин)
;