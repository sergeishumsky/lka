@ВПодсистеме
структура ОписаниеНоменклатуры
    пер name: Строка
    пер id: Строка
    
;

@ВПодсистеме
структура СтрокаРекламации
    пер Деталь_Ид: Строка
    пер Количество: Число
    пер Стоимость: Число
    пер Причина_Ид: Строка
    пер Цена: Число
    пер Деталь_Тип: Строка
    пер НомерПоИнструкции: Строка
    
;

@ВПодсистеме
структура СтрокаРекламацииКратко
    пер Деталь_Ид: Строка
    пер Стоимость: Число
    пер Цена: Число
    
;


метод ОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    
    знч ДанныеРекламаций = ПолучитьДанныеРекламаций()
    знч ТелоОтвета = СериализацияJson.ЗаписатьОбъект(ДанныеРекламаций)
    
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    Запрос.Ответ.УстановитьТело(ТелоОтвета)
    
;

метод ВыгрузитьНоменклатуру(Запрос: HttpСервисЗапрос)
    
    знч Стадии = Запрос.Параметры.ПолучитьВсе("stage")
    
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    
    исп ПотокЗаписиТела = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    ЗаписатьДанныеРекламацийВПоток(ПотокЗаписиТела, Стадии)
   
;

метод ПолучитьИдКлиента(КлиентСсылка: Клиенты.Ссылка?): Строка

    если КлиентСсылка == Неопределено
     
        возврат ""
        
    ;

    возврат КлиентСсылка.ЗагрузитьОбъект().ВнешнийИдентификатор.ВСтроку()

;

метод ПолучитьИдКонтрагента(КонтрагентСсылка: Контрагенты.Ссылка?): Строка

    если КонтрагентСсылка == Неопределено
     
        возврат ""
        
    ;
    
    возврат КонтрагентСсылка.ЗагрузитьОбъект().ВнешнийИдентификатор.ВСтроку()

;


метод ПолучитьИдНоменклатуры(НоменклатураСсылка: Номенкатура.Ссылка?): Строка

    если НоменклатураСсылка == Неопределено
     
        возврат ""
        
    ;

    возврат НоменклатураСсылка.ЗагрузитьОбъект().ВнешнийИдентификатор.ВСтроку()

;

метод ПолучитьИдДетали(ДетальСсылка: Детали.Ссылка?): Строка

    если ДетальСсылка == Неопределено
     
        возврат ""
        
    ;

    возврат ДетальСсылка.ЗагрузитьОбъект().ВнешнийИдентификатор.ВСтроку()

;

метод ПолучитьТипДетали(ДетальСсылка: Детали.Ссылка?): Строка

    если ДетальСсылка == Неопределено
     
        возврат ""
        
    ;

    возврат ДетальСсылка.ЗагрузитьОбъект().ТипДетали.ВСтроку()

;


метод ПолучитьИдПричины(ПричинаСсылка: ПричиныРекламаций.Ссылка?): Строка

    если ПричинаСсылка == Неопределено
     
        возврат ""
        
    ;

    возврат ПричинаСсылка.ЗагрузитьОбъект().ВнешнийИдентификатор.ВСтроку()

;


метод ПолучитьМассивДеталейРекламации(Рекламация: Рекламация.Ссылка): Массив<СтрокаРекламации>

    знч Запрос = Запрос{
        ВЫБРАТЬ
            Состав.Деталь КАК Деталь,
            Состав.Количество КАК Количество,
            Состав.Стоимость КАК Стоимость,
            Состав.Цена КАК Цена,
            Состав.НомерПоИнструкции КАК НомерПоИнструкции,
            Состав.Причина КАК Причина
        ИЗ
            Рекламация.Состав КАК Состав
        ГДЕ
            Состав.Владелец == %Рекламация
    }
    
    знч МассивДеталей = <СтрокаРекламации>[]
    
    для СтрокаРезультата из Запрос.Выполнить()
        
        знч СтрокаРекламации = новый СтрокаРекламации()
        
        СтрокаРекламации.Деталь_Тип = ПолучитьТипДетали(СтрокаРезультата.Деталь)
        СтрокаРекламации.Деталь_Ид = ПолучитьИдДетали(СтрокаРезультата.Деталь)
        СтрокаРекламации.Причина_Ид = ПолучитьИдПричины(СтрокаРезультата.Причина)
        СтрокаРекламации.Количество = СтрокаРезультата.Количество
        СтрокаРекламации.Цена = СтрокаРезультата.Цена
        СтрокаРекламации.Стоимость = СтрокаРезультата.Стоимость
        СтрокаРекламации.НомерПоИнструкции = СтрокаРезультата.НомерПоИнструкции
        
        МассивДеталей.Добавить(СтрокаРекламации)  
    ;
    
    возврат МассивДеталей    
    
;

метод ЗаписатьДанныеРекламацийВПоток(ПотокЗаписи: ПотокЗаписи, Стадии: ЧитаемыйМассив<Строка>)
    
    знч СтатусОтменено = СтатусРекламации.ОтмененоКлиентом
    знч СтатусНовая = СтатусРекламации.Новая
    
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Рекламация.Дата КАК Дата,
            Рекламация.ДатаПроизводства КАК ДатаПроизводства,
            Рекламация.Статус КАК Статус,
            Рекламация.Клиент КАК Клиент,
            Рекламация.Изделие КАК Изделие,
            Рекламация.Деталь КАК Деталь,
            Рекламация.Платная КАК Платная,
            Рекламация.ЗапросЦены КАК ЗапросЦены,
            Рекламация.Валюта.Наименование КАК Валюта,
            Рекламация.Количество.ВСтроку() КАК Количество,
            Рекламация.НомерПоИнструкции КАК НомерПоИнструкции,
            Рекламация.ВнешнийИдентификатор.ВСтроку() КАК ВнешнийИдентификатор,
            Рекламация.Клиент КАК Покупатель,
            Рекламация.Покупатель КАК Контрагент,
            Рекламация.Примечание КАК Примечание,
            Рекламация.Номер КАК Номер,
            Рекламация.НомерКлиента КАК НомерКлиента,
            Рекламация.Ссылка КАК Ссылка
        ИЗ 
            Рекламация КАК Рекламация
        ГДЕ
            Рекламация.Статус == %СтатусОтменено
            ИЛИ Рекламация.Статус == %СтатусНовая
    }
    
    ПотокЗаписи.Записать("[")
    
    пер Первый = Истина
    для СтрокаРезультата из Запрос.Выполнить()
        если не Первый
            ПотокЗаписи.Записать(",\n")
        ;
        Первый = Ложь
        
        знч СделкаСоответствие: Соответствие<Строка, Объект?> = {
            "Дата" : СтрокаРезультата.Дата.ВСтроку(),
            "ДатаПроизводства" : СтрокаРезультата.ДатаПроизводства.ВСтроку(),
            "Платная" : СтрокаРезультата.Платная.ВСтроку(),
            "ЗапросЦены" : СтрокаРезультата.ЗапросЦены.ВСтроку(),
            "НомерПоИнструкции" : СтрокаРезультата.НомерПоИнструкции,
            "Валюта" : СтрокаРезультата.Валюта.Представление(),
            "Клиент" : СтрокаРезультата.Клиент.Представление(),
            "Количество" : СтрокаРезультата.Количество,
            "Клиент_Ид" : ПолучитьИдКлиента(СтрокаРезультата.Клиент),
            "Изделие_Ид" : ПолучитьИдНоменклатуры(СтрокаРезультата.Изделие),
            "Номенклатура_Ид": ПолучитьИдДетали(СтрокаРезультата.Деталь),
            "Номер": СтрокаРезультата.Номер.ВСтроку(),
            "НомерКлиента": СтрокаРезультата.НомерКлиента.ВСтроку(),
            "Контрагент" : СтрокаРезультата.Контрагент.Представление(),
            "Контрагент_Ид" : ПолучитьИдКонтрагента(СтрокаРезультата.Контрагент),
            "ВнешнийИдентификатор" : СтрокаРезультата.ВнешнийИдентификатор, 
            "Примечание" : СтрокаРезультата.Примечание,
            "Статус": СтрокаРезультата.Статус.ВСтроку(),
            "Состав": ПолучитьМассивДеталейРекламации(СтрокаРезультата.Ссылка)
            
            
        }
        
        ПотокЗаписи.Записать(СериализацияJson.ЗаписатьОбъект(СделкаСоответствие))
    ;
    
    ПотокЗаписи.Записать("]") 
;

метод ПолучитьДанныеРекламаций(): ЧитаемоеСоответствие<Строка, Объект?>?
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Рекламация.Дата КАК Дата,
            Рекламация.Клиент КАК Клиент,
            Рекламация.Деталь КАК Номенклатура
        ИЗ 
            Рекламация КАК Рекламация
    }
    
    для СтрокаРезультата из Запрос.Выполнить()
        знч СделкаСоответствие: Соответствие<Строка, Объект?> = {
            "Дата" : СтрокаРезультата.Дата,
            "Клиент" : СтрокаРезультата.Клиент.Представление(),
            "Номенклатура" : СтрокаРезультата.Номенклатура.Представление()
        }
        
        возврат СделкаСоответствие
    ;
    
    возврат Неопределено
;

метод ЗагрузитьНоменклатуру(Запрос: HttpСервисЗапрос)

    знч ТелоЗапроса = Запрос.Тело.ПрочитатьКакСтроку()
    знч Чтение = new ЧтениеJson(ТелоЗапроса)
    
    // Позиционируемся на начало массива
    если не Чтение.Следующий()
        возврат
    ;
    // Позиционируемся на первый элемент массива
    если не Чтение.Следующий()
        возврат
    ;    

    пер ДанныеНоменклатуры = Чтение.ПрочитатьСодержимоеКакСоответствие()
    
    пер МассивНоменклатуры = ДанныеНоменклатуры.Получить("data") как неизвестно
    
    для ЭлементМассива из МассивНоменклатуры

        знч Наименование = ЭлементМассива["name"] как Строка
        знч Код = ЭлементМассива["id"] как Строка
        
        знч НаименованиеКоллекции = ЭлементМассива["collection_name"] как Строка
        знч КодКоллекции = ЭлементМассива["collection_id"] как Строка
        
        знч МассивДеталей = ЭлементМассива["details"] как неизвестно
        
        ОбновитьДобавитьНоменклатуру(Код, Наименование, КодКоллекции, НаименованиеКоллекции, МассивДеталей)
    ;
    
       
    знч ДанныеТранзакции: Соответствие<Строка, Объект?> = {
            "Статус" : "Успешно"
    }
        
    знч ТелоОтвета = СериализацияJson.ЗаписатьОбъект(ДанныеТранзакции)
            
    
    Запрос.Ответ.УстановитьКодСтатуса(200)
    Запрос.Ответ.УстановитьТело(ТелоОтвета)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    
    
    
;

метод ПолучитьКоллекциюПоКоду(Код: Строка, Наименование: Строка): Коллекции.Ссылка

    знч Коллекция = Коллекции.НайтиПоКоду(Код)
    
    если Коллекция == Неопределено 
    
        знч КоллекцияОбъект = новый Коллекции.Объект()
        КоллекцияОбъект.Наименование = Наименование
        КоллекцияОбъект.Код = Код
        КоллекцияОбъект.Записать()
       
        возврат КоллекцияОбъект.Ссылка
    
    иначе    
    
        знч КоллекцияОбъект = Коллекция.ЗагрузитьОбъект()
        КоллекцияОбъект.Наименование = Наименование
        КоллекцияОбъект.Записать()
        
        возврат Коллекция 
    
    ;
    
;

метод ПолучитьНоменклатуруПоИдентификатору(Код: Строка): Номенкатура.Ссылка?
 
    знч ВнешнийИдентификатор = новый Ууид(Код)
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Номенклатура.Ссылка КАК Ссылка
        ИЗ 
            Номенкатура КАК Номенклатура
        ГДЕ 
            Номенклатура.ВнешнийИдентификатор == %ВнешнийИдентификатор и Номенклатура.ПровереннаяПозиция == Ложь}
        
    
    возврат Запрос.Выполнить().ЕдинственныйИлиНеопределено()?.Ссылка
    
    
;

метод ПолучитьКлиентаПоИдентификатору(Код: Строка): Клиенты.Ссылка?
 
    знч ВнешнийИдентификатор = новый Ууид(Код)
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Клиенты.Ссылка КАК Ссылка
        ИЗ 
            Клиенты КАК Клиенты
        ГДЕ 
            Клиенты.ВнешнийИдентификатор == %ВнешнийИдентификатор}
        
    
    возврат Запрос.Выполнить().ЕдинственныйИлиНеопределено()?.Ссылка
    
    
;

метод ПолучитьПричинуРекламацииПоИдентификатору(Код: Строка): ПричиныРекламаций.Ссылка?
 
    знч ВнешнийИдентификатор = новый Ууид(Код)
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            ПричиныРекламаций.Ссылка КАК Ссылка
        ИЗ 
            ПричиныРекламаций КАК ПричиныРекламаций
        ГДЕ 
            ПричиныРекламаций.ВнешнийИдентификатор == %ВнешнийИдентификатор}
        
    
    возврат Запрос.Выполнить().ЕдинственныйИлиНеопределено()?.Ссылка
    
    
;


метод ПолучитьКонтрагентаПоИдентификатору(Код: Строка): Контрагенты.Ссылка?
 
    знч ВнешнийИдентификатор = новый Ууид(Код)
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Контрагенты.Ссылка КАК Ссылка
        ИЗ 
            Контрагенты КАК Контрагенты
        ГДЕ 
            Контрагенты.ВнешнийИдентификатор == %ВнешнийИдентификатор}
        
    
    возврат Запрос.Выполнить().ЕдинственныйИлиНеопределено()?.Ссылка
    
    
;


метод ПолучитьДетальПоИд(Код: Строка): Детали.Ссылка?

    знч ВнешнийИдентификатор = новый Ууид(Код)
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Детали.Ссылка КАК Ссылка
        ИЗ 
            Детали КАК Детали
        ГДЕ 
            Детали.ВнешнийИдентификатор == %ВнешнийИдентификатор}
        
    
    знч ДетальСсылка = Запрос.Выполнить().ЕдинственныйИлиНеопределено()?.Ссылка

    возврат ДетальСсылка
;

метод ПолучитьДетальПоИдентификатору(Код: Строка, Наименование: Строка, ТипДетали: Строка, НомерПачки: Строка, НомерДеталиПоИнструкции: Строка, Обновить: Булево): Детали.Ссылка?
 
    знч ВнешнийИдентификатор = новый Ууид(Код)
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Детали.Ссылка КАК Ссылка
        ИЗ 
            Детали КАК Детали
        ГДЕ 
            Детали.ВнешнийИдентификатор == %ВнешнийИдентификатор}
        
    
    пер ДетальСсылка = Запрос.Выполнить().ЕдинственныйИлиНеопределено()?.Ссылка
    
    если ДетальСсылка == Неопределено
    
        знч ДетальОбъект = новый Детали.Объект()
        ДетальОбъект.ВнешнийИдентификатор = новый Ууид(Код)
        ДетальОбъект.Наименование = Наименование
        ДетальОбъект.НомерПоИнструкции = НомерДеталиПоИнструкции
        ДетальОбъект.Пачка = НомерПачки
        ДетальОбъект.ТипДетали = ТипыДеталей.ПоИмени(ТипДетали)
        ДетальОбъект.Записать()
        
        ДетальСсылка = ДетальОбъект.Ссылка
    
    иначе
        
        знч ДетальОбъектОбновить = ДетальСсылка.ЗагрузитьОбъект()
        ДетальОбъектОбновить.Наименование = Наименование
        ДетальОбъектОбновить.НомерПоИнструкции = НомерДеталиПоИнструкции
        ДетальОбъектОбновить.Пачка = НомерПачки
        ДетальОбъектОбновить.ТипДетали = ТипыДеталей.ПоИмени(ТипДетали)
        ДетальОбъектОбновить.Записать()
    ;
    
    возврат ДетальСсылка
;


метод ОбновитьДобавитьНоменклатуру(Код: Строка, Наименование: Строка, КодКоллекции: Строка, НаименованиеКоллекции: Строка, МассивДеталей: неизвестно, Обновить: Булево = Ложь)

    знч КоллекцияСсылка = ПолучитьКоллекциюПоКоду(КодКоллекции, НаименованиеКоллекции)    
    
    знч Номенклатура = ПолучитьНоменклатуруПоИдентификатору(Код)
    
    
    
    если Номенклатура == Неопределено 
    
        знч НоменклатураОбъект = новый Номенкатура.Объект()
        НоменклатураОбъект.Наименование = Наименование
        НоменклатураОбъект.ВнешнийИдентификатор = новый Ууид(Код)
        НоменклатураОбъект.Коллекция = КоллекцияСсылка
        
        для ЭлементМассива из МассивДеталей 
          
            знч КодДетали = ЭлементМассива["detail_id"] как Строка
            знч НаименованиеДетали = ЭлементМассива["detail_name"] как Строка
            знч ТипДетали = ЭлементМассива["detail_type"] как Строка
            знч НомерПачки = ЭлементМассива["detail_pack"] как Строка
            знч НомерПоИнструкции = ЭлементМассива["detail_partnumber"] как Строка
            знч Количество = ЭлементМассива["detail_q"] как Число

          
            знч ДетальСсылка = ПолучитьДетальПоИдентификатору(КодДетали, НаименованиеДетали,ТипДетали, НомерПачки, НомерПоИнструкции, Обновить)
            
            знч НоваяСтрока = НоменклатураОбъект.СписокДеталей.ДобавитьНовый()
            НоваяСтрока.Деталь = ДетальСсылка
            НоваяСтрока.Количество = Количество
            
        ;
        
        НоменклатураОбъект.Записать()
        
    иначе    
    
        знч НоменклатураОбъект = Номенклатура.ЗагрузитьОбъект()
        НоменклатураОбъект.Наименование = Наименование
        НоменклатураОбъект.Коллекция = КоллекцияСсылка
        //НоменклатураОбъект.ПровереннаяПозиция = Истина
        НоменклатураОбъект.СписокДеталей.Очистить()
        
        для ЭлементМассива из МассивДеталей 
          
            знч КодДетали = ЭлементМассива["detail_id"] как Строка
            знч НаименованиеДетали = ЭлементМассива["detail_name"] как Строка
            знч ТипДетали = ЭлементМассива["detail_type"] как Строка
            знч НомерПачки = ЭлементМассива["detail_pack"] как Строка
            знч НомерПоИнструкции = ЭлементМассива["detail_partnumber"] как Строка
            знч Количество = ЭлементМассива["detail_q"] как Число
          
            знч ДетальСсылка = ПолучитьДетальПоИдентификатору(КодДетали, НаименованиеДетали,ТипДетали, НомерПачки, НомерПоИнструкции, Обновить)
            
            знч НоваяСтрока = НоменклатураОбъект.СписокДеталей.ДобавитьНовый()
            НоваяСтрока.Деталь = ДетальСсылка
            НоваяСтрока.Количество = Количество
            
        ;
        
        НоменклатураОбъект.Записать()    
    ;
    
;

метод ОбновитьДобавитьКлиента(Код: Строка, Наименование: Строка, Обновить: Булево = Ложь)

    знч Клиент = ПолучитьКлиентаПоИдентификатору(Код)
    
    если Клиент == Неопределено 
    
        знч КлиентОбъект = новый Клиенты.Объект()
        КлиентОбъект.Наименование = Наименование
        КлиентОбъект.ВнешнийИдентификатор = новый Ууид(Код)
       
        КлиентОбъект.Записать()
        
    иначе если Обновить    
    
        знч КлиентОбъект = Клиент.ЗагрузитьОбъект()
        КлиентОбъект.Наименование = Наименование
        КлиентОбъект.Записать()    
    ;
    
;

метод ОбновитьДобавитьПричинуРекламации(Код: Строка, Наименование: Строка, Обновить: Булево = Ложь)

    знч ПричинаРекламации = ПолучитьПричинуРекламацииПоИдентификатору(Код)
    
    если ПричинаРекламации == Неопределено 
    
        знч ПричинаРекламацииОбъект = новый ПричиныРекламаций.Объект()
        ПричинаРекламацииОбъект.Наименование = Наименование
        ПричинаРекламацииОбъект.ВнешнийИдентификатор = новый Ууид(Код)
       
        ПричинаРекламацииОбъект.Записать()
        
    иначе    
    
        знч ПричинаРекламацииОбъект = ПричинаРекламации.ЗагрузитьОбъект()
        ПричинаРекламацииОбъект.Наименование = Наименование
        ПричинаРекламацииОбъект.Записать()    
    ;
    
;


метод ОбновитьДобавитьКонтрагента(Код: Строка, Наименование: Строка, КодКлиента: Строка, Обновить: Булево)

    знч Клиент = ПолучитьКлиентаПоИдентификатору(КодКлиента)
    
    знч Контрагент = ПолучитьКонтрагентаПоИдентификатору(Код)
    
    если Контрагент == Неопределено 
    
        знч КонтрагентОбъект = новый Контрагенты.Объект()
        КонтрагентОбъект.Наименование = Наименование
        КонтрагентОбъект.Владелец = Клиент 
        КонтрагентОбъект.ВнешнийИдентификатор = новый Ууид(Код)
        КонтрагентОбъект.Записать()
        
    иначе если Обновить    
    
        знч КонтрагентОбъект = Контрагент.ЗагрузитьОбъект()
        КонтрагентОбъект.Наименование = Наименование
        КонтрагентОбъект.Записать()    
    ;
    
;

метод ПолучитьРекламациюПоИд(Ид: Строка): Рекламация.Ссылка?

    знч ВнешнийИдентификатор = новый Ууид(Ид)
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Рекламация.Ссылка КАК Ссылка
        ИЗ 
            Рекламация КАК Рекламация
        ГДЕ 
            Рекламация.ВнешнийИдентификатор == %ВнешнийИдентификатор}
        
    
    пер РекламацияСсылка = Запрос.Выполнить().ЕдинственныйИлиНеопределено()?.Ссылка

    возврат РекламацияСсылка
    
;

метод ОбновитьРекламацию(Ид: Строка, Статус: Строка, 
    Вес: Строка, Объем: Строка, 
    Стоимость: Строка, Платная: Строка,
    КомментарийПроизводителя: Строка, ДатаУпаковки: Строка, Состав: неизвестно)

    знч РекламацияСсылка = ПолучитьРекламациюПоИд(Ид)
    
    если РекламацияСсылка != Неопределено
     
        знч РекламацияОбъект = РекламацияСсылка.ЗагрузитьОбъект()
        РекламацияОбъект.Платная = Платная == "Да"
        
        РекламацияОбъект.Статус = СтатусРекламации.ПоИмени(Статус)
        //РекламацияОбъект.Вес = новый Число(Вес)
        //РекламацияОбъект.Объем = новый Число(Объем)
        РекламацияОбъект.Стоимость = РекламацияОбъект.Платная ? новый Число(Стоимость) : 0
        РекламацияОбъект.КомментарийПроизводителя = КомментарийПроизводителя
        
        если ДатаУпаковки.Пусто()
            
            РекламацияОбъект.ДатаУпаковки = Неопределено
            
        иначе
            
            РекламацияОбъект.ДатаУпаковки = новый Дата(ДатаУпаковки)
            
        ;
        
            
        
        
        
        для СтрокаСостав из Состав
 
            знч КодДетали = СтрокаСостав["Деталь_Ид"] как Строка   
                
            знч Деталь = ПолучитьДетальПоИд(КодДетали)
            
            для СтрокаРекламации из РекламацияОбъект.Состав
            
                если СтрокаРекламации.Деталь == Деталь
                    
                    СтрокаРекламации.Цена = СтрокаСостав["Цена"] как Число
                    СтрокаРекламации.Стоимость = СтрокаСостав["Стоимость"] как Число    
                    
                ;    
            ;
        ;
        РекламацияОбъект.Записать()
    ;
    
;

метод ОбновитьРекламации(Запрос: HttpСервисЗапрос)

    знч ТелоЗапроса = Запрос.Тело.ПрочитатьКакСтроку()
    знч Чтение = new ЧтениеJson(ТелоЗапроса)
    
    // Позиционируемся на начало массива
    если не Чтение.Следующий()
        возврат
    ;
    // Позиционируемся на первый элемент массива
    если не Чтение.Следующий()
        возврат
    ;    

    пер ДанныеРекламаций = Чтение.ПрочитатьСодержимоеКакСоответствие()
    
    пер МассивРекламаций = ДанныеРекламаций.Получить("data") как неизвестно
    
    для ЭлементМассива из МассивРекламаций

        знч Статус = ЭлементМассива["статус"] как Строка
        знч Платная = ЭлементМассива["платная"] как Строка
        знч Вес = ЭлементМассива["вес"] как Строка
        знч Объем = ЭлементМассива["объем"] как Строка
        знч Стоимость = ЭлементМассива["стоимость"] как Строка
        знч Ид = ЭлементМассива["ид"] как Строка
        знч КомментарийПроизводителя = ЭлементМассива["комментарийпроизводителя"] как Строка
        знч ДатаУпаковки = ЭлементМассива["датаупаковки"] как Строка
        знч Состав = ЭлементМассива["Состав"] как неизвестно
        
        ОбновитьРекламацию(Ид, Статус, Вес, Объем, Стоимость, Платная, КомментарийПроизводителя, ДатаУпаковки, Состав)
    ;
    
       
    знч ДанныеТранзакции: Соответствие<Строка, Объект?> = {
            "Статус" : "Успешно"
    }
        
    знч ТелоОтвета = СериализацияJson.ЗаписатьОбъект(ДанныеТранзакции)
            
    
    Запрос.Ответ.УстановитьКодСтатуса(200)
    Запрос.Ответ.УстановитьТело(ТелоОтвета)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    
;

метод ЗагрузитьДанныеКлиентов(Запрос: HttpСервисЗапрос)

    знч ТелоЗапроса = Запрос.Тело.ПрочитатьКакСтроку()
    знч Чтение = new ЧтениеJson(ТелоЗапроса)
    
    // Позиционируемся на начало массива
    если не Чтение.Следующий()
        возврат
    ;
    // Позиционируемся на первый элемент массива
    если не Чтение.Следующий()
        возврат
    ;    

    пер ДанныеУчетныхЗаписей = Чтение.ПрочитатьСодержимоеКакСоответствие()
    
    пер МассивКлиентов = ДанныеУчетныхЗаписей.Получить("customers") как неизвестно
    
    для ЭлементМассива из МассивКлиентов

        знч Наименование = ЭлементМассива["customer_name"] как Строка
        знч Код = ЭлементМассива["customer_id"] как Строка
        
        
        ОбновитьДобавитьКлиента(Код, Наименование)
    ;


    пер МассивКонтрагентов = ДанныеУчетныхЗаписей.Получить("endcustomers") как неизвестно
    
    для ЭлементМассива из МассивКонтрагентов

        //знч Наименование = ЭлементМассива["customer_name"] как Строка
        знч Код = ЭлементМассива["customer_id"] как Строка

        знч НаименованиеКонтрагента = ЭлементМассива["endcustomer_name"] как Строка
        знч КодКонтрагента = ЭлементМассива["endcustomer_id"] как Строка
        
        ОбновитьДобавитьКонтрагента(КодКонтрагента, НаименованиеКонтрагента, Код, Ложь)
        
        
    ;
    
    пер МассивПользователей = ДанныеУчетныхЗаписей.Получить("users") как неизвестно

    знч СписокПользователей = СпискиПользователей.ПолучитьСписокПоУмолчанию()
    
    знч МассивОписаний = СпискиПользователей.ПолучитьПользователей(СписокПользователей.Ид)
   
    для ЭлементМассива из МассивПользователей
        
        пер ПользовательСуществует = Ложь
        
        знч ЭлектроннаяПочта = ЭлементМассива["email"] как Строка
        
        для Описание из МассивОписаний
            если Описание.ЭлектроннаяПочта == ЭлектроннаяПочта
                    
                    // дописать код изменить статус действующий
                ПользовательСуществует = Истина
                прервать
            ;
        ;
        
        если ПользовательСуществует != Истина
        
            знч Описание = новый ОписаниеПользователяСервиса(СписокПользователей.Ид, ЭлектроннаяПочта, ЭлектроннаяПочта)
                    .СЭлектроннойПочтой(ЭлектроннаяПочта)
                
                ПользователиСервиса.Создать(Описание)
                
                ПользователиСервиса.СброситьПароль(Описание.Ид, "12345678")
                
                знч Пользователь = Пользователи.Подключить(Описание.Ид).Ссылка
                
                знч СотрудникОбъект = новый Сотрудники.Объект()
                
                знч КодКлиента = ЭлементМассива["customer_id"] как Строка 
                
                СотрудникОбъект.Клиент = ПолучитьКлиентаПоИдентификатору(КодКлиента)
                СотрудникОбъект.Наименование = ЭлектроннаяПочта
                СотрудникОбъект.Роль = РольСотрудника.Менеджер
                СотрудникОбъект.Пользователь = Пользователь
                СотрудникОбъект.Записать()
                
            ;        
        ;
    
    пер МассивПричинРекламаций = ДанныеУчетныхЗаписей.Получить("reasons") как неизвестно
    
    для ЭлементМассива из МассивПричинРекламаций

        знч Наименование = ЭлементМассива["reason_name"] как Строка
        знч Код = ЭлементМассива["reason_id"] как Строка
        
        
        ОбновитьДобавитьПричинуРекламации(Код, Наименование)
    ;

       
    знч ДанныеТранзакции: Соответствие<Строка, Объект?> = {
            "Статус" : "Успешно"
    }
        
    знч ТелоОтвета = СериализацияJson.ЗаписатьОбъект(ДанныеТранзакции)
            
    ПеречистатьПраваНаСервере()
    
    Запрос.Ответ.УстановитьКодСтатуса(200)
    Запрос.Ответ.УстановитьТело(ТелоОтвета)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    
    
    
;

@НаСервере
метод ПеречистатьПраваНаСервере()

    Сотрудники.ПересчитатьРазрешенияДоступа()
    Сотрудники.ПересчитатьРазрешенияДоступаДляОбъектов()

    Клиенты.ПересчитатьРазрешенияДоступа()
    Клиенты.ПересчитатьРазрешенияДоступаДляОбъектов()
    
    Контрагенты.ПересчитатьРазрешенияДоступа()
    Контрагенты.ПересчитатьРазрешенияДоступаДляОбъектов()

    Рекламация.ПересчитатьРазрешенияДоступа()
    Рекламация.ПересчитатьРазрешенияДоступаДляОбъектов()

    РеестрРекламаций.ПересчитатьРазрешенияДоступа()
    РеестрРекламаций.ПересчитатьРазрешенияДоступаДляОбъектов()
    
    /*для Справочник из Справочники
        Справочник.ПересчитатьРазрешенияДоступа()
        Справочник.ПересчитатьРазрешенияДоступаДляОбъектов()
    ;
    для Документ из Документы
        Документ.ПересчитатьРазрешенияДоступа()
        Документ.ПересчитатьРазрешенияДоступаДляОбъектов()
    ;    
    для Сервис из HttpСервисы
        Сервис.ПересчитатьРазрешенияДоступа()
    ;*/
    
    Пользователи.ПересчитатьКлючиДоступа() 
       
;


метод ВыгрузитьФото_5Версия(Запрос: HttpСервисЗапрос)
    
    знч ИдРекламации = Запрос.Параметры.ПолучитьПервый("rec_id")

    если ИдРекламации != Неопределено
            
        исп ПотокЗаписиТела = Запрос.Ответ.ОткрытьПотокЗаписиТела()
        
        ЗаписатьДанныеМедиаВПоток(ПотокЗаписиТела, ИдРекламации)
        
        знч ТелоОтвета = СериализацияJson.ЗаписатьОбъект(ПотокЗаписиТела)
        //знч ТелоОтвета = ПотокЗаписиТела.ВСтроку()
        
        Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
        Запрос.Ответ.УстановитьТело(ТелоОтвета)
        возврат
    
    ;
    
    Запрос.Ответ.УстановитьКодСтатуса(404)
    Запрос.Ответ.УстановитьТело("Рекламация не найдена")   
     
;

метод ВыгрузитьФото(Запрос: HttpСервисЗапрос)
    знч ИдРекламации = Запрос.Параметры.ПолучитьПервый("rec_id")

    если ИдРекламации != Неопределено
        исп ПотокЗаписиТела = Запрос.Ответ.ОткрытьПотокЗаписиТела()

        ЗаписатьДанныеМедиаВПоток(ПотокЗаписиТела, ИдРекламации)

        //знч ТелоОтвета = СериализацияJson.ЗаписатьОбъект(ПотокЗаписиТела)
        //знч ТелоОтвета = ПотокЗаписиТела.ВСтроку()

        //Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
        //Запрос.Ответ.УстановитьТело(ТелоОтвета)
        возврат
    ;

    Запрос.Ответ.УстановитьКодСтатуса(404)
    Запрос.Ответ.УстановитьТело("Рекламация не найдена")
;

метод ЗаписатьДанныеМедиаВПоток__(ПотокЗаписи: ПотокЗаписи, ИдРекламации: Строка)

    знч РекламацияСсылка = ПолучитьРекламациюПоИд(ИдРекламации)
    
    ПотокЗаписи.Записать("[")
    
    если РекламацияСсылка != Неопределено
        
        знч МассивМедиа = РекламацияСсылка.ЗагрузитьОбъект().МассивФайлов
       
        пер Сч = 1        
        
        для ЭлементМассива из МассивМедиа
            
            попытка 
                
                знч ДанныеСоответствие: Соответствие<Строка, Объект?> = {
                    "id" : Сч,
                    "image" : Кодировки.Base64.КодироватьВСтроку(ЭлементМассива.Загрузить().ПолучитьБайты()) 
                }
            
                ПотокЗаписи.Записать(СериализацияJson.ЗаписатьОбъект(ДанныеСоответствие))
                
                Сч = Сч + 1        
            
            поймать Искл: ИсключениеДвоичногоОбъекта            
            
            
            ;
        ;
        
        
    ;
    
    ПотокЗаписи.Записать("]")
    
     
;

метод ЗаписатьДанныеМедиаВПоток(ПотокЗаписи: ПотокЗаписи, ИдРекламации: Строка)

    знч РекламацияСсылка = ПолучитьРекламациюПоИд(ИдРекламации)
    
    ПотокЗаписи.Записать("[")
    
    если РекламацияСсылка != Неопределено
        
        знч МассивМедиа = РекламацияСсылка.ЗагрузитьОбъект().МассивФайлов
       
        пер Сч = 1        
        
        для ЭлементМассива из МассивМедиа
            
            исп ПотокЧтения = ЭлементМассива.Загрузить().ОткрытьПотокЧтения()
            знч ЧтениеДанных = новый ЧтениеДанных(ПотокЧтения)
            
            попытка 
            
                знч ЗаписьJSON = новый ЗаписьJson(ПотокЗаписи)
                ЗаписьJSON.ЗаписатьНачалоОбъекта()
                ЗаписьJSON.Записать("id", Сч)
                ЗаписьJSON.Записать("image", ЧтениеДанных.Прочитать().ПолучитьБайты())               
                ЗаписьJSON.ЗаписатьКонецОбъекта()
            
            поймать Искл: ИсключениеДвоичногоОбъекта            
            
            
            ;
        ;
        
        
    ;
    
    ПотокЗаписи.Записать("]")
    
     
;


метод ЗаписатьДанныеРеестровВПоток(ПотокЗаписи: ПотокЗаписи)
    
    знч Запрос = Запрос{
        ВЫБРАТЬ
            РеестрРекламаций.Дата КАК Дата,
            РеестрРекламаций.ВнешнийИдентификатор.ВСтроку() КАК ВнешнийИдентификатор,
            РеестрРекламаций.Клиент КАК Клиент,
            РеестрРекламаций.СканДокумента КАК СканДокумента,
            РеестрРекламаций.Ссылка КАК Ссылка
        ИЗ 
            РеестрРекламаций КАК РеестрРекламаций
        ГДЕ
            НЕ РеестрРекламаций.РеестрПринят
    }
    
    ПотокЗаписи.Записать("[")
    
    пер Первый = Истина
    для СтрокаРезультата из Запрос.Выполнить()
        
        если СтрокаРезультата.СканДокумента == Неопределено
        
            продолжить    
        ;
        
        если не Первый
            ПотокЗаписи.Записать(",\n")
        ;
        Первый = Ложь
        
        знч СделкаСоответствие: Соответствие<Строка, Объект?> = {
            "Дата" : СтрокаРезультата.Дата.ВСтроку(),
            "Клиент_Ид" : ПолучитьИдКлиента(СтрокаРезультата.Клиент),
            "ВнешнийИдентификатор" : СтрокаРезультата.ВнешнийИдентификатор,
            "image" : Кодировки.Base64.КодироватьВСтроку(СтрокаРезультата.СканДокумента.Загрузить().ПолучитьБайты())           
        }
        
        ПотокЗаписи.Записать(СериализацияJson.ЗаписатьОбъект(СделкаСоответствие))
    ;
    
    ПотокЗаписи.Записать("]") 
;


метод ВыгрузитьРеестры(Запрос: HttpСервисЗапрос)
    
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    
    исп ПотокЗаписиТела = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    ЗаписатьДанныеРеестровВПоток(ПотокЗаписиТела)
    
    
;

метод ПолучитьРеестрПоИд(Ид: Строка): РеестрРекламаций.Ссылка?

    знч ВнешнийИдентификатор = новый Ууид(Ид)
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            РеестрРекламаций.Ссылка КАК Ссылка
        ИЗ 
            РеестрРекламаций КАК РеестрРекламаций
        ГДЕ 
            РеестрРекламаций.ВнешнийИдентификатор == %ВнешнийИдентификатор}
        
    
    пер РеестрСсылка = Запрос.Выполнить().ЕдинственныйИлиНеопределено()?.Ссылка

    возврат РеестрСсылка
    
;

метод ОбновитьРеестр(Запрос: HttpСервисЗапрос)

    знч ТелоЗапроса = Запрос.Тело.ПрочитатьКакСтроку()
    знч Чтение = new ЧтениеJson(ТелоЗапроса)
    
    // Позиционируемся на начало массива
    если не Чтение.Следующий()
        возврат
    ;
    // Позиционируемся на первый элемент массива
    если не Чтение.Следующий()
        возврат
    ;    

    пер ДанныеРееестров = Чтение.ПрочитатьСодержимоеКакСоответствие()
    
    пер МассивРеестров = ДанныеРееестров.Получить("data") как неизвестно
    
    для ЭлементМассива из МассивРеестров

        знч Ид = ЭлементМассива["ид"] как Строка
        знч РеестПринят  = ЭлементМассива["реестрпринят"] как Булево    
    
        знч РеестрСсылка = ПолучитьРеестрПоИд(Ид)
    
        если РеестрСсылка != Неопределено
     
            знч РеестрОбъект = РеестрСсылка.ЗагрузитьОбъект()
            РеестрОбъект.РеестрПринят = РеестПринят
        
            РеестрОбъект.Записать()
        ;
    
    ;
    
       
    знч ДанныеТранзакции: Соответствие<Строка, Объект?> = {
            "Статус" : "Успешно"
    }
        
    знч ТелоОтвета = СериализацияJson.ЗаписатьОбъект(ДанныеТранзакции)
            
    
    Запрос.Ответ.УстановитьКодСтатуса(200)
    Запрос.Ответ.УстановитьТело(ТелоОтвета)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    
;


метод ОбновитьРеестры(Запрос: HttpСервисЗапрос)
    
    ОбновитьРеестр(Запрос)
    
;



метод ОбновитьНоменклатуруPOSTОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    
    // обновить информацию по изделиям
    знч ТелоЗапроса = Запрос.Тело.ПрочитатьКакСтроку()
    знч Чтение = new ЧтениеJson(ТелоЗапроса)

    // Позиционируемся на начало массива
    если не Чтение.Следующий()
        возврат
    ;
    // Позиционируемся на первый элемент массива
    если не Чтение.Следующий()
        возврат
    ;

    пер ДанныеНоменклатуры = Чтение.ПрочитатьСодержимоеКакСоответствие()

    пер МассивНоменклатуры = ДанныеНоменклатуры.Получить("data") как неизвестно

    для ЭлементМассива из МассивНоменклатуры
        знч Наименование = ЭлементМассива["name"] как Строка
        знч Ид = ЭлементМассива["id"] как Строка
        знч ВнешнийИд = ЭлементМассива["external_id"] как Строка


        //знч МассивДеталей = ЭлементМассива["details"] как неизвестно

        ОбновитьВнешнийИД(Ид, ВнешнийИд, Наименование)
    ;

    знч ДанныеТранзакции: Соответствие<Строка, Объект?> = {
        "Статус": "Успешно"
    }

    знч ТелоОтвета = СериализацияJson.ЗаписатьОбъект(ДанныеТранзакции)

    Запрос.Ответ.УстановитьКодСтатуса(200)
    Запрос.Ответ.УстановитьТело(ТелоОтвета)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    
;

метод ОбновитьВнешнийИД(Ид: Строка, ВнешнийИд: Строка, Наименование: Строка)

    знч Номенклатура = ПолучитьНоменклатуруПоИдентификатору(Ид)
    
    если Номенклатура == Неопределено 
    
        
    иначе    

        знч ОригинальнаяНоменклатура = ПолучитьНоменклатуруПоИдентификатору(ВнешнийИд)
        
        знч НоменклатураОбъект = Номенклатура.ЗагрузитьОбъект()
        
        если ОригинальнаяНоменклатура == Неопределено 
        
        иначе
        
            // проверенная позиция - значит дубль
            НоменклатураОбъект.ПровереннаяПозиция = Истина
        
        ;
        
        НоменклатураОбъект.Комментарий = НоменклатураОбъект.ВнешнийИдентификатор.ВСтроку()
        НоменклатураОбъект.ВнешнийИдентификатор = новый Ууид(ВнешнийИд)
        
        НоменклатураОбъект.Записать()    
    ;
    
;
