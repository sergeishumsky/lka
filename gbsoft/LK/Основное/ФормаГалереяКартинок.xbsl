@Обработчик
метод ПослеСоздания()
    
    ВывестиМассивКартинок()
  
;

@НаСервере @ДоступноСКлиента
статический метод ПроверитьТипФайла(Данные: ДвоичныйОбъект.Ссылка): Булево
    
    знч ДвоичныйОбъект = Данные.Загрузить()
    знч ТипДанных = ДвоичныйОбъект.ТипСодержимого
    
    возврат ТипДанных.Содержит("image")
    
;

метод ВывестиМассивКартинок()

    знч ГруппаДляРазмещения = Компоненты.АвтоГруппа
    
    ГруппаДляРазмещения.Содержимое.Очистить()
    
    СоответствиеКнопкаИндекс.Очистить()
    
    пер Индекс = 0
    
    для Данные из МассивФайлов
    
        знч ГруппаКонтейнер = новый Группа()
        ГруппаКонтейнер.Рамка = Истина
        
        знч ЭтоКартинка = ПроверитьТипФайла(Данные)
        
        знч КомпонентПДФ = новый КарточкаПДФ()
        КомпонентПДФ.Данные = Данные
        
        
        
        знч Картинка = новый Картинка()
        Картинка.Изображение = Данные
        Картинка.ОбрабатыватьНажатие = Истина
        Картинка.ОткрыватьВНовомОкне = Истина
        Картинка.ПриНажатии = &ПриНажатии
    
        знч КнопкаУдалить = новый Кнопка()
        КнопкаУдалить.Картинка.Изображение = Ресурс{МусорнаяКорзина.svg}.Ссылка
        КнопкаУдалить.ВыравниваниеВГруппеПоГоризонтали = ВыравниваниеПоГоризонтали.Конец
        КнопкаУдалить.ПриНажатии = &ОбработчикУдалитьКартинку
        СоответствиеКнопкаИндекс.Вставить(КнопкаУдалить, Индекс)
        
        если ЭтоКартинка 
        
            ГруппаКонтейнер.Содержимое.Добавить(Картинка)
            
        иначе
            
            ГруппаКонтейнер.Содержимое.Добавить(КомпонентПДФ)
            
        ;
        
        ГруппаКонтейнер.Содержимое.Добавить(КнопкаУдалить)
        
        ГруппаДляРазмещения.Содержимое.Добавить(ГруппаКонтейнер)
        
        
        
        Индекс = Индекс + 1
        
    ;
    
;

метод ПриИзменении(Источник: ВыборФайлов, Событие: СобытиеПриИзменении<ЧитаемыйМассив<ВыбранныйФайл>>)
    
    знч МассивЗначений = Событие.НовоеЗначение
    
    для Файл из МассивЗначений 
        
        знч Изображение = ЗагрузкаФайлов.НачатьЗагрузку(Файл).ПолучитьРезультат()    
        МассивФайлов.Добавить(Изображение)  
    ;
    
    
    ВывестиМассивКартинок()
    
;

метод ПриНажатии(Источник: Картинка, Событие: СобытиеПриНажатии)

    //ФормаПросмотраКартинки.ОткрытьВМодальномОкне(Картинка = Источник.Изображение)
    ФормаПросмотраКартинки.ОткрытьВМодальномОкне(Картинка = Источник.Изображение)
;

метод ОбработчикУдалитьКартинку(Источник: Кнопка, Событие: СобытиеПриНажатии)
    
    знч Индекс = СоответствиеКнопкаИндекс.ПолучитьИлиНеопределено(Источник)
    
    МассивФайлов.УдалитьПоИндексу(Индекс)
    
    ВывестиМассивКартинок()
        
;