конст ИМЯ_ФАЙЛА_ВЫГРУЗКИ = "Заявки.xls"

метод ПолучитьИконкуВложений(ДанныеСтроки: неизвестно): ДвоичныйОбъект.Ссылка?
    возврат ДанныеСтроки.Данные["МассивФайлов"].Пусто() ? Неопределено : Ресурс{Вложение.svg}.Ссылка
;

метод КоличествоДнейСДатыСоздания(ДанныеСтроки: неизвестно): Строка

    знч ТекущаяДата = ДатаВремя.Сейчас()
    
    знч ДатаСоздания = ДанныеСтроки.Данные["Дата"]

    знч Длительность = ТекущаяДата - ДатаСоздания
    
    возврат Длительность.Дни.ВСтроку()
    
;

метод ВыгрузитьВЭксель(Команда: ОбычнаяКоманда)

    знч ДанныеСотрудника = ПользователиКлиентИСервер.ПолучитьДанныеТекущегоПользователя()
    
    знч ФильтрДатаС = (этот.Компоненты.ОсновнаяТаблица.Источник.Фильтр.Элементы[0] как ГруппаЭлементовФильтра).Элементы[0]
    знч ФильтрДатаПо = (этот.Компоненты.ОсновнаяТаблица.Источник.Фильтр.Элементы[0] как ГруппаЭлементовФильтра).Элементы[1]
    
    знч ДвоичнаяСсылка = РекламацииКлиентИСервер.ВыгрузитьЗаявкиКлиентаВExcel(ДанныеСотрудника.Клиент, (ФильтрДатаС как ЭлементФильтра).Значение как ДатаВремя?, (ФильтрДатаПо как ЭлементФильтра).Значение как ДатаВремя?)
    
    
    
    ВыгрузкаФайлов.НачатьВыгрузку(ДвоичнаяСсылка, ИМЯ_ФАЙЛА_ВЫГРУЗКИ)

;

метод ПолучитьКартинкуСтроки(ЗапросЦены: Булево, Платная: Булево): ДвоичныйОбъект.Ссылка|Неопределено

    если ЗапросЦены
        
        возврат Ресурс{ИнформацияВКругеКонтур.svg}.Ссылка
        
    иначе если Платная
     
        возврат Ресурс{ТегКонтур.svg}.Ссылка 
        
    иначе
        
        возврат Неопределено   
    ;
    
;

 