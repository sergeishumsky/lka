@Обработчик
метод ВычислитьРазрешенияДоступа(): ЧитаемаяКоллекция<РазрешениеДоступа>
    возврат [новый РазрешениеДоступа(
            [новый КлючДоступаДляАутентифицированных.Объект()],
            [Сущность.Право.Создание, Сущность.Право.Чтение, Сущность.Право.Изменение, Сущность.Право.Удаление])]
;

@Обработчик
метод ВычислитьРазрешенияДоступаДляОбъектов(Объекты: ЧитаемыйМассив<Рекламация.ДанныеРасчетаРазрешений>): 
    ЧитаемоеСоответствие<Рекламация.ДанныеРасчетаРазрешений, ЧитаемаяКоллекция<РазрешениеДоступа>>
    
    знч Результат = <Рекламация.ДанныеРасчетаРазрешений, Массив<РазрешениеДоступа>>{:}
    
    для Объект из Объекты
        знч Разрешения = <РазрешениеДоступа>[
            новый РазрешениеДоступа(
                [новый КлючДоступаПоКлиенту.Объект(Клиент = Объект.Клиент)],
                [Сущность.Право.Создание, Сущность.Право.Чтение, Сущность.Право.Изменение]),
            новый РазрешениеДоступа(
                [новый КлючДоступаРуководителя.Объект()],
                [Сущность.Право.Создание, Сущность.Право.Чтение, Сущность.Право.Изменение])
        ]
        
        Результат.Вставить(Объект, Разрешения)
    ;
    
    возврат Результат
    
;

@ВПодсистеме
метод ПолучитьРекламацииКлиента(Клиент: Клиенты.Ссылка, ДатаС: ДатаВремя?, ДатаПо: ДатаВремя?): ЧитаемыйМассив<Рекламация.Ссылка>
    
    если ДатаС == Неопределено или ДатаПо == Неопределено
    
        знч Запрос = Запрос{
            ВЫБРАТЬ
                Ссылка
            ИЗ
                Рекламация КАК Рекламация
            ГДЕ
                Рекламация.Клиент == %Клиент
        }
        знч РезультатЗапроса = Запрос.Выполнить()
        знч РекламацииКлиента = <Рекламация.Ссылка>[]
        для СтрокаРезультата из РезультатЗапроса
            РекламацииКлиента.Добавить(СтрокаРезультата.Ссылка)
        ;
    
        возврат РекламацииКлиента
        
    иначе
        
        знч ДатаНачала = ДатаС как ДатаВремя
        знч ДатаОкончания = ДатаПо как ДатаВремя
        
        знч Запрос = Запрос{
            ВЫБРАТЬ
                Ссылка
            ИЗ
                Рекламация КАК Рекламация
            ГДЕ
                Рекламация.Клиент == %Клиент И Рекламация.Дата >= %ДатаНачала И Рекламация.Дата <= %ДатаОкончания
        }
        знч РезультатЗапроса = Запрос.Выполнить()
        знч РекламацииКлиента = <Рекламация.Ссылка>[]
        для СтрокаРезультата из РезультатЗапроса
            РекламацииКлиента.Добавить(СтрокаРезультата.Ссылка)
        ;
    
        возврат РекламацииКлиента
        
    ;
    
    
;


@ВПодсистеме
метод ПолучитьВсеРекламации(): ЧитаемыйМассив<Рекламация.Ссылка>
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Ссылка
        ИЗ
            Рекламация КАК Рекламация
    }
    знч РезультатЗапроса = Запрос.Выполнить()
    знч РекламацииКлиента = <Рекламация.Ссылка>[]
    для СтрокаРезультата из РезультатЗапроса
        РекламацииКлиента.Добавить(СтрокаРезультата.Ссылка)
    ;

    возврат РекламацииКлиента

;