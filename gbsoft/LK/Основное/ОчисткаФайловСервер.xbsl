@ВПроекте @НаСервере @ДоступноСКлиента
метод НайтиФайлы(Начало: ДатаВремя, Конец: ДатаВремя, Смещение: Число): РезультатПоискаФайлов
    ПроверитьДоступИПериод(Начало, Конец)
    если Смещение < 0
        выбросить новый ИсключениеНедопустимыйАргумент("Некорректное смещение")
    ;
    знч СтатусОтгружено = СтатусРекламации.Отгружено
    знч Запрос = Запрос{
        ВЫБРАТЬ Ссылка
        ИЗ Рекламация
        ГДЕ Дата >= %Начало И Дата <= %Конец И Статус == %СтатусОтгружено
        УПОРЯДОЧИТЬ ПО Ссылка
        ПОЛУЧИТЬ 100 СО СМЕЩЕНИЕМ %Смещение
    }
    знч Результат = новый РезультатПоискаФайлов()
    для СтрокаЗапроса из Запрос.Выполнить()
        Результат.КоличествоДокументов = Результат.КоличествоДокументов + 1
        знч Документ = СтрокаЗапроса.Ссылка.ЗагрузитьОбъект()
        знч Клиент = Документ.Клиент
        пер ПредставлениеКлиента = ""
        если Клиент != Неопределено
            ПредставлениеКлиента = Клиент!.Представление()
        ;
        для СсылкаНаФайл из Документ.МассивФайлов
            знч Файл = СсылкаНаФайл.Загрузить()
            Результат.Файлы.Добавить(новый ФайлДляОчистки(
                Рекламация = СтрокаЗапроса.Ссылка,
                Клиент = ПредставлениеКлиента,
                ДатаРекламации = Документ.Дата,
                Файл = СсылкаНаФайл,
                ИмяФайла = Файл.ИмяФайла,
                Размер = Файл.Размер.ВБайтах()))
        ;
    ;
    возврат Результат
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ОчиститьФайлы(Начало: ДатаВремя, Конец: ДатаВремя, Файлы: Массив<ФайлДляОчистки>): Число
    ПроверитьДоступИПериод(Начало, Конец)
    пер Удалено = 0
    для СтрокаФайла из Файлы
        если СтрокаФайла.Рекламация == Неопределено или СтрокаФайла.Файл == Неопределено
            продолжить
        ;
        знч Документ = СтрокаФайла.Рекламация!.ЗагрузитьОбъект()
        // Повторно проверяем условия: статус и дата могли измениться после анализа.
        если Документ.Статус != СтатусРекламации.Отгружено или Документ.Дата < Начало или Документ.Дата > Конец
            продолжить
        ;
        пер Индекс = Документ.МассивФайлов.Размер() - 1
        пока Индекс >= 0
            если Документ.МассивФайлов[Индекс] == СтрокаФайла.Файл
                Документ.МассивФайлов.УдалитьПоИндексу(Индекс)
                Документ.Записать()
                Удалено = Удалено + 1
                прервать
            ;
            Индекс = Индекс - 1
        ;
    ;
    возврат Удалено
;

@НаСервере
метод ПроверитьДоступИПериод(Начало: ДатаВремя, Конец: ДатаВремя)
    если не ПользователиКлиентИСервер.ЭтоАдминистраторПриложения()
        выбросить новый ИсключениеНедопустимоеСостояние("Очистка доступна только администратору приложения")
    ;
    если Начало > Конец
        выбросить новый ИсключениеНедопустимыйАргумент("Начало периода позже окончания")
    ;
;
