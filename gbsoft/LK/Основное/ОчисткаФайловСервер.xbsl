@ВПроекте @НаСервере @ДоступноСКлиента
метод НайтиФайлы(Начало: ДатаВремя, Конец: ДатаВремя, Смещение: Число): РезультатПоискаФайлов
    ПроверитьДоступИПериод(Начало, Конец)
    если Смещение < 0
        выбросить новый ИсключениеНедопустимыйАргумент("Некорректное смещение")
    ;
    знч СтатусОтгружено = СтатусРекламации.Отгружено
    знч Запрос = Запрос{
        ВЫБРАТЬ Ссылка
        ИЗ Рекламация
        ГДЕ Дата >= %Начало И Дата <= %Конец И Статус == %СтатусОтгружено
        УПОРЯДОЧИТЬ ПО Ссылка
        ПОЛУЧИТЬ 100 СО СМЕЩЕНИЕМ %Смещение
    }
    знч Результат = новый РезультатПоискаФайлов()
    для СтрокаЗапроса из Запрос.Выполнить()
        Результат.КоличествоДокументов = Результат.КоличествоДокументов + 1
        знч Документ = СтрокаЗапроса.Ссылка.ЗагрузитьОбъект()
        знч Клиент = Документ.Клиент
        пер ПредставлениеКлиента = ""
        если Клиент != Неопределено
            ПредставлениеКлиента = Клиент!.Представление()
        ;
        для СсылкаНаФайл из Документ.МассивФайлов
            знч Файл = СсылкаНаФайл.Загрузить()
            Результат.Файлы.Добавить(новый ФайлДляОчистки(
                Рекламация = СтрокаЗапроса.Ссылка,
                Клиент = ПредставлениеКлиента,
                ДатаРекламации = Документ.Дата,
                СтатусРекламации = Документ.Статус.Представление(),
                Файл = СсылкаНаФайл,
                ИмяФайла = Файл.ИмяФайла,
                Размер = Файл.Размер.ВБайтах(),
                РазмерМБ = (Файл.Размер.ВБайтах() / 1048576).Округлить(2)))
        ;
    ;
    возврат Результат
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ОчиститьФайлы(Начало: ДатаВремя, Конец: ДатаВремя, Файлы: Массив<ФайлДляОчистки>): Число
    ПроверитьДоступИПериод(Начало, Конец)
    пер Удалено = 0
    для СтрокаФайла из Файлы
        если СтрокаФайла.Рекламация == Неопределено или СтрокаФайла.Файл == Неопределено
            продолжить
        ;
        знч Документ = СтрокаФайла.Рекламация!.ЗагрузитьОбъект()
        // Повторно проверяем условия: статус и дата могли измениться после анализа.
        если Документ.Статус != СтатусРекламации.Отгружено или Документ.Дата < Начало или Документ.Дата > Конец
            продолжить
        ;
        пер Индекс = Документ.МассивФайлов.Размер() - 1
        пока Индекс >= 0
            если Документ.МассивФайлов[Индекс] == СтрокаФайла.Файл
                знч УдаляемыйФайл = Документ.МассивФайлов[Индекс]
                Документ.МассивФайлов.УдалитьПоИндексу(Индекс)
                Документ.Записать()
                // Сообщаем хранилищу только после успешного удаления сохраненной ссылки.
                ОбъектноеХранилище.УстановитьНеиспользуемые(УдаляемыйФайл)
                Удалено = Удалено + 1
                прервать
            ;
            Индекс = Индекс - 1
        ;
    ;
    возврат Удалено
;

// Считаем документы по тому же фильтру, включая рекламации без вложений.
@ВПроекте @НаСервере @ДоступноСКлиента
метод КоличествоРекламаций(Начало: ДатаВремя, Конец: ДатаВремя): Число
    ПроверитьДоступИПериод(Начало, Конец)
    знч СтатусОтгружено = СтатусРекламации.Отгружено
    знч Запрос = Запрос{
        ВЫБРАТЬ КОЛИЧЕСТВО(Ссылка) КАК Количество
        ИЗ Рекламация
        ГДЕ Дата >= %Начало И Дата <= %Конец И Статус == %СтатусОтгружено
    }
    возврат Запрос.Выполнить().Единственный().Количество
;

// Фиксируем только ссылки: очистка не загружает метаданные и размеры файлов.
// Состав этой очереди не меняется при удалении вложений или смене статусов.
@ВПроекте @НаСервере @ДоступноСКлиента
метод РекламацииДляОчистки(Начало: ДатаВремя, Конец: ДатаВремя): Массив<Рекламация.Ссылка>
    ПроверитьДоступИПериод(Начало, Конец)
    знч СтатусОтгружено = СтатусРекламации.Отгружено
    знч Запрос = Запрос{
        ВЫБРАТЬ Ссылка
        ИЗ Рекламация
        ГДЕ Дата >= %Начало И Дата <= %Конец И Статус == %СтатусОтгружено
        УПОРЯДОЧИТЬ ПО Ссылка
    }
    знч Рекламации = новый Массив<Рекламация.Ссылка>()
    для СтрокаЗапроса из Запрос.Выполнить()
        Рекламации.Добавить(СтрокаЗапроса.Ссылка)
    ;
    возврат Рекламации
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ОчиститьПорциюРекламаций(Начало: ДатаВремя, Конец: ДатаВремя, Рекламации: Массив<Рекламация.Ссылка>): Число
    ПроверитьДоступИПериод(Начало, Конец)
    если Рекламации.Размер() > 100
        выбросить новый ИсключениеНедопустимыйАргумент("Размер порции не должен превышать 100 рекламаций")
    ;
    пер Удалено = 0
    для Ссылка из Рекламации
        знч Документ = Ссылка.ЗагрузитьОбъект()
        если Документ.Статус != СтатусРекламации.Отгружено или Документ.Дата < Начало или Документ.Дата > Конец
            продолжить
        ;
        знч Количество = Документ.МассивФайлов.Размер()
        если Количество > 0
            // Нужна копия: очистка массива документа не должна очистить список для хранилища.
            знч УдаляемыеФайлы = новый Массив<ДвоичныйОбъект.Ссылка>(Документ.МассивФайлов)
            Документ.МассивФайлов.Очистить()
            Документ.Записать()
            ОбъектноеХранилище.УстановитьНеиспользуемые(УдаляемыеФайлы)
            Удалено = Удалено + Количество
        ;
    ;
    возврат Удалено
;

// Возвращаем только сумму размеров из метаданных, без содержимого файлов.
@ВПроекте @НаСервере @ДоступноСКлиента
метод РазмерВложенийПорции(Начало: ДатаВремя, Конец: ДатаВремя, Рекламации: Массив<Рекламация.Ссылка>): Число
    ПроверитьДоступИПериод(Начало, Конец)
    если Рекламации.Размер() > 100
        выбросить новый ИсключениеНедопустимыйАргумент("Размер порции не должен превышать 100 рекламаций")
    ;
    пер РазмерБайтов = 0
    для Ссылка из Рекламации
        знч Документ = Ссылка.ЗагрузитьОбъект()
        если Документ.Статус != СтатусРекламации.Отгружено или Документ.Дата < Начало или Документ.Дата > Конец
            продолжить
        ;
        для СсылкаНаФайл из Документ.МассивФайлов
            РазмерБайтов = РазмерБайтов + СсылкаНаФайл.Загрузить().Размер.ВБайтах()
        ;
    ;
    возврат РазмерБайтов
;

@НаСервере
метод ПроверитьДоступИПериод(Начало: ДатаВремя, Конец: ДатаВремя)
    если не ПользователиКлиентИСервер.ЭтоАдминистраторПриложения()
        выбросить новый ИсключениеНедопустимоеСостояние("Очистка доступна только администратору приложения")
    ;
    если Начало > Конец
        выбросить новый ИсключениеНедопустимыйАргумент("Начало периода позже окончания")
    ;
;
