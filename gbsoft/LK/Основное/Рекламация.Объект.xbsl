@Обработчик
метод ПриЗаполнении(ТекстЗаполнения: Строка)

    Пользователь = Пользователи.ТекущийПользователь
    
    знч ДанныеПользователя = ПользователиКлиентИСервер.ПолучитьДанныеТекущегоПользователя()
    
    Валюта = ДанныеПользователя.Валюта
    
    Клиент = ДанныеПользователя.Клиент
    
    Покупатель = ДанныеПользователя.Покупатель
    
    Сотрудник = ДанныеПользователя.Сотрудник
    
    ВнешнийИдентификатор = новый Ууид()
    
    Дата = ДатаВремя.Сейчас()
;

@Обработчик
@ВПодсистеме
метод ПослеЗаписи(До: Рекламация.Данные, ПараметрыЗаписи: Рекламация.ПараметрыЗаписи)
    
    
    
    если этот.Дата < ДатаВремя{2024-12-20 0:00:00}
        
        возврат
            
    ;
    
    если этот.Платная 
        
        возврат
            
    ;
    
    знч ДатаРекламации = этот.Дата.Дата
    знч КлиентРекламации = этот.Клиент
    
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            РеестрРекламаций.Ссылка КАК Ссылка
        ИЗ
            РеестрРекламаций КАК РеестрРекламаций
        ГДЕ
            РеестрРекламаций.Дата == %ДатаРекламации
            И РеестрРекламаций.Клиент == %КлиентРекламации
    }    

    исп ПривелигированныйРежим = КонтекстДоступа.Привилегированный()
    
    попытка 
        
        исп Результат = Запрос.Выполнить()
        
        если Результат.Пусто()
            
            знч НовыйРеестр = новый РеестрРекламаций.Объект()
            НовыйРеестр.Клиент = КлиентРекламации
            НовыйРеестр.Дата = ДатаРекламации
            НовыйРеестр.Записать()
            
        ;
    
    вконце
    
        
    ;
    
    ПривелигированныйРежим.Закрыть()
    
;