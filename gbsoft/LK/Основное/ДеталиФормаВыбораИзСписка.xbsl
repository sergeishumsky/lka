метод ИсточникДанныхСпискаМероприятий(): ИсточникДанныхМассив<ОписаниеДетали>
    
    возврат Компоненты.ТаблицаДеталей.Источник
    
;

@ВПроекте
метод ЗагрузитьДетали()
    ИсточникДанныхСпискаМероприятий().Данные.Очистить()
    знч МассивДеталей = ПолучитьДетали(Изделие)
    ИсточникДанныхСпискаМероприятий().Данные.ДобавитьВсе(МассивДеталей)
    
    пер ДоступностьКнопка1 = Ложь
    пер ДоступностьКнопка2 = Ложь
    пер ДоступностьКнопка3 = Ложь
    пер ДоступностьКнопка4 = Ложь
    пер ДоступностьКнопка5 = Ложь
    
    для СтрокаДетали из МассивДеталей
    
        если СтрокаДетали.Пачка == "1"
            
            ДоступностьКнопка1 = Истина
        
        иначе если СтрокаДетали.Пачка == "2"
           
            ДоступностьКнопка2 = Истина
            
        иначе если СтрокаДетали.Пачка == "3"    
            
            ДоступностьКнопка3 = Истина
            
        иначе если СтрокаДетали.Пачка == "4"
            
            ДоступностьКнопка4 = Истина
            
        иначе если СтрокаДетали.Пачка == "5"
        
            ДоступностьКнопка5 = Истина
            
        ;
    ;
    
    (этот.ДополнительныеКоманды.Элементы[2] как Команда).Доступность = ДоступностьКнопка1
    (этот.ДополнительныеКоманды.Элементы[3] как Команда).Доступность = ДоступностьКнопка2
    (этот.ДополнительныеКоманды.Элементы[4] как Команда).Доступность = ДоступностьКнопка3
    (этот.ДополнительныеКоманды.Элементы[5] как Команда).Доступность = ДоступностьКнопка4
    (этот.ДополнительныеКоманды.Элементы[6] как Команда).Доступность = ДоступностьКнопка5
;

@ВПроекте
метод ЗагрузитьДеталиПоНомеруПачки(НомерПачки: Строка)
    ИсточникДанныхСпискаМероприятий().Данные.Очистить()
    знч МассивДеталей = ПолучитьДеталиПоНомеруПачки(Изделие, НомерПачки)
    ИсточникДанныхСпискаМероприятий().Данные.ДобавитьВсе(МассивДеталей)
    
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьДетали(Владелец: Номенкатура.Ссылка): ЧитаемыйМассив<ОписаниеДетали>

    знч МассивДеталей = <ОписаниеДетали>[]
    
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Детали.Деталь КАК Деталь,
            Детали.Количество КАК Количество
         ИЗ 
            Номенкатура.СписокДеталей КАК Детали 
         ГДЕ 
            Детали.Владелец == %Владелец
    }
    
    для СтрокаРезультата из Запрос.Выполнить()
        
        знч ОписаниеДетали = новый ОписаниеДетали()
        
        ОписаниеДетали.Деталь = СтрокаРезультата.Деталь
        
        знч ДетальОбъект = СтрокаРезультата.Деталь.ЗагрузитьОбъект()

        если ДетальОбъект == Неопределено
            
            продолжить    
            
        ;
        
        ОписаниеДетали.НомерПоИнструкции = ДетальОбъект.НомерПоИнструкции
        ОписаниеДетали.ТипДетали = ДетальОбъект.ТипДетали
        ОписаниеДетали.Пачка = ДетальОбъект.Пачка
        ОписаниеДетали.Количество = СтрокаРезультата.Количество
        ОписаниеДетали.Отметка = Ложь
        
        МассивДеталей.Добавить(ОписаниеДетали)  
    ;
    
    возврат МассивДеталей
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьДеталиПоНомеруПачки(Владелец: Номенкатура.Ссылка, НомерПачки: Строка): ЧитаемыйМассив<ОписаниеДетали>

    знч МассивДеталей = <ОписаниеДетали>[]
    
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Детали.Деталь КАК Деталь,
            Детали.Количество КАК Количество
         ИЗ 
            Номенкатура.СписокДеталей КАК Детали 
         ГДЕ 
            Детали.Владелец == %Владелец
    }
    
    для СтрокаРезультата из Запрос.Выполнить()
        
        знч ОписаниеДетали = новый ОписаниеДетали()
        
        ОписаниеДетали.Деталь = СтрокаРезультата.Деталь
        
        знч ДетальОбъект = СтрокаРезультата.Деталь.ЗагрузитьОбъект()

        если ДетальОбъект == Неопределено или ДетальОбъект.Пачка != НомерПачки
            
            продолжить    
            
        ;
        
        ОписаниеДетали.НомерПоИнструкции = ДетальОбъект.НомерПоИнструкции
        ОписаниеДетали.ТипДетали = ДетальОбъект.ТипДетали
        ОписаниеДетали.Пачка = ДетальОбъект.Пачка
        ОписаниеДетали.Количество = СтрокаРезультата.Количество
        ОписаниеДетали.Отметка = Ложь
        
        МассивДеталей.Добавить(ОписаниеДетали)  
    ;
    
    возврат МассивДеталей
;


@Обработчик
метод ПослеСоздания()
    
    ЗагрузитьДетали()    
    
;

