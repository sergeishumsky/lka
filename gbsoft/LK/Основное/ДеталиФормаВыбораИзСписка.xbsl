метод Обработчик(Команда: ПереключаемаяКоманда)
    
    Компоненты.ТаблицаДеталей.ИспользоватьОтметкиСтрок = Команда.Активна
    этот.ОсновнаяКоманда.Видимость = Команда.Активна
    
;


метод ВыбратьДетали(Команда: ОбычнаяКоманда)
    
    знч МассивДеталей = новый Массив<Детали.Ссылка>()
    
    для СтрокаДетали из Компоненты.ТаблицаДеталей.Источник.Данные
    
        если СтрокаДетали.Отметка
         
            МассивДеталей.Добавить(СтрокаДетали.Деталь)
            
        ;    
        
    ;   
    
    Закрыть(МассивДеталей)
    
;


метод ПриВыделенииСтроки(Источник: Список<ИсточникДанныхМассив<ОписаниеДетали>>, Событие: СобытиеСДанными<ОписаниеДетали?>)
    // TODO Вставить содержимое обработчика
;


метод ВыбратьВсе(Команда: ОбычнаяКоманда)
    
    для Элемент из Компоненты.ТаблицаДеталей.Источник.Данные
        
        Элемент.Отметка = Истина
        
    ;
    
    Компоненты.ТаблицаДеталей.Обновить()
;

метод ОтменитьВсе(Команда: ОбычнаяКоманда)

    для Элемент из Компоненты.ТаблицаДеталей.Источник.Данные
        
        Элемент.Отметка = Ложь
        
    ;

;



метод ФильтрПачка1(Команда: ОбычнаяКоманда)
    
    ЗагрузитьДеталиПоНомеруПачки("1")
    
;

метод ФильтрПачка2(Команда: ОбычнаяКоманда)
    
    ЗагрузитьДеталиПоНомеруПачки("2")
    
;

метод ФильтрПачка3(Команда: ОбычнаяКоманда)
    
    ЗагрузитьДеталиПоНомеруПачки("3")
    
;

метод ФильтрПачка4(Команда: ОбычнаяКоманда)
    
    ЗагрузитьДеталиПоНомеруПачки("4")
    
;

метод ФильтрПачка5(Команда: ОбычнаяКоманда)
    
    ЗагрузитьДеталиПоНомеруПачки("5")
    
;

метод ОтменитьВыбор(Команда: ОбычнаяКоманда)

    знч МассивДеталей = новый Массив<Детали.Ссылка>()
        
    Закрыть(МассивДеталей)    
;