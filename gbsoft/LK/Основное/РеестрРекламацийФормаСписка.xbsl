импорт ПечатьДокументов

@НаСервере @ДоступноСКлиента
статический метод ПечатьРеестраНаСервере(РеестрСсылка: РеестрРекламаций.Ссылка): ДвоичныйОбъект.Ссылка
    
    знч ДокументОбъект = РеестрСсылка.ЗагрузитьОбъект()
    
    возврат РекламацииКлиентИСервер.ВыгрузитьРеестрВPDF(ДокументОбъект.Клиент, ДокументОбъект.Дата)   
    
;

метод ПечатьРеестра(Команда: КомандаСПараметром<СтрокаДинамическогоСписка>, Параметр: СтрокаДинамическогоСписка)
    
    знч РеестрСсылка = Параметр.Ключ как РеестрРекламаций.Ссылка
    
    ПечатьДокументовКлиент.ОткрытьФормуДокумента(ПечатьРеестраНаСервере(РеестрСсылка), "Реестр рекламаций")
    
;

метод ПрикрепитьФайл(Команда: КомандаСПараметром<Массив<Сущность.Ключ>>, Параметр: Массив<Сущность.Ключ>)
    
    знч ДокументСсылка = Параметр.ЕдинственныйИлиНеопределено() как РеестрРекламаций.Ссылка?
    если ДокументСсылка == Неопределено
    
        возврат
        
    ;
    
    //знч ДокументОбъект = ДокументСсылка.ЗагрузитьОбъект()
    
;