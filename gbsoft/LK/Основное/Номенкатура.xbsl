@ВПодсистеме
метод ПолучитьВсюНоменклатуру(): ЧитаемыйМассив<Номенкатура.Ссылка>
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Ссылка
        ИЗ
            Номенкатура КАК Номенклатура
    }
    
    знч РезультатЗапроса = Запрос.Выполнить()
    знч Номенклатура = <Номенкатура.Ссылка>[]
    для СтрокаРезультата из РезультатЗапроса
        Номенклатура.Добавить(СтрокаРезультата.Ссылка)
    ;
    возврат Номенклатура
;


@ВПодсистеме
метод ПолучитьВсеДетали1(): ЧитаемыйМассив<Детали.Ссылка>
    
    знч ТипДетали = ТипыДеталей.Деталь
    знч Пачка1 = "1"
    
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Ссылка
        ИЗ
            Детали КАК Детали
        ГДЕ
            Детали.ТипДетали == %ТипДетали
            И Детали.Пачка == %Пачка1
    }
    
    знч РезультатЗапроса = Запрос.Выполнить()
    знч Номенклатура = <Детали.Ссылка>[]
    для СтрокаРезультата из РезультатЗапроса
        Номенклатура.Добавить(СтрокаРезультата.Ссылка)
    ;
    возврат Номенклатура
;

@ВПодсистеме
метод ПолучитьВсеДетали2(): ЧитаемыйМассив<Детали.Ссылка>
    знч ТипДетали = ТипыДеталей.Деталь
    знч Пачка1 = "1"

    знч Запрос = Запрос{
        ВЫБРАТЬ
            Ссылка
        ИЗ
            Детали КАК Детали
        ГДЕ
            Детали.ТипДетали == %ТипДетали
             И Детали.Пачка != %Пачка1
    }

    знч РезультатЗапроса = Запрос.Выполнить()
    знч Номенклатура = <Детали.Ссылка>[]
    для СтрокаРезультата из РезультатЗапроса
        Номенклатура.Добавить(СтрокаРезультата.Ссылка)
    ;
    возврат Номенклатура
;


