@Обработчик
метод ПередЗаписью()

    ПересчитатьСтоимость()    

    пер ПоляНеЗаполнены: Булево
    
    если Объект.ДатаПроизводства == Дата{}
        Компоненты.ДатаПроизводства.РезультатПроверкиДанных = РезультатПроверкиДанных.Ошибка
        ПоляНеЗаполнены = Истина
    иначе
        Компоненты.ДатаПроизводства.РезультатПроверкиДанных = РезультатПроверкиДанных.Отсутствует
    ;

    если Объект.Изделие == Неопределено
        //Компоненты.ИзделиеНадпись.РезультатПроверкиДанных = РезультатПроверкиДанных.Ошибка
        ПоляНеЗаполнены = Истина
    иначе
        //Компоненты.ИзделиеНадпись.РезультатПроверкиДанных = РезультатПроверкиДанных.Отсутствует
    ;


    если ПоляНеЗаполнены
        выбросить новый ИсключениеВалидации("Не заполнены обязательные поля", ОтображатьСообщениеОбОшибке = Ложь)
    ;


;

@Обработчик
метод ПослеЧтения()
    
    пер КомандаПлатно = ДополнительныеКоманды.Элементы[0] как ПереключаемаяКоманда
    пер КомандаЗапросЦены = ДополнительныеКоманды.Элементы[1] как ПереключаемаяКоманда
    КомандаПлатно.Активна = Объект.Платная
    КомандаЗапросЦены.Активна = Объект.ЗапросЦены
    
    Компоненты.Клиент.ОткрытьЗначение.Видимость = Ложь
    Компоненты.Покупатель.ОткрытьЗначение.Видимость = Ложь
    
    Компоненты.Стоимость.Заголовок = "Стоимость, " + Объект.Валюта.Представление()    
;

@Обработчик
метод ПослеСоздания()
    
    
    если КлиентскоеУстройство.ШиринаОкнаПриложения <  КлиентскоеУстройство.ВысотаОкнаПриложения
        
        Компоненты.ГоризонтальнаяГруппа.Компоновка = КомпоновкаСодержимого.Вертикальная
        
    ;          
    
;

    
    

@Обработчик
метод ПослеЗаписи()


;


метод ОтменитьРекламацию(Команда: ОбычнаяКоманда)

    Объект.Статус = СтатусРекламации.ОтмененоКлиентом
    
;


метод Обработчик(Команда: ПереключаемаяКоманда)

    Объект.Платная = Команда.Активна
    
    если не Объект.Платная
     
        Объект.ЗапросЦены = Ложь
        
        пер КомандаЗапросЦены = ДополнительныеКоманды.Элементы[1] как ПереключаемаяКоманда
   
        КомандаЗапросЦены.Активна = Объект.ЗапросЦены
        
    ;
    
;
@НаСервере @ДоступноСКлиента
статический метод ПолучитьНомерПоИнструкции(Деталь: Детали.Ссылка): Строка

    знч Запрос = Запрос{
            ВЫБРАТЬ
                Детали.НомерПоИнструкции КАК НомерПоИнструкции
            ИЗ 
                Детали КАК Детали 
            ГДЕ 
                Детали.Ссылка == %Деталь
        }

    возврат Запрос.Выполнить().ЕдинственныйИлиНеопределено()?.НомерПоИнструкции
;

метод ОбработчикДобавитьДеталь(Команда: ОбычнаяКоманда)
    
    если Объект.Изделие == Неопределено
    
        возврат
        
    ;
    
    знч ПолученноеЗначение = ДеталиФормаВыбораИзСписка.ОткрытьВМодальномОкне(Изделие = Объект.Изделие)
    
    если ПолученноеЗначение == Неопределено 
     
        возврат
        
    ;
    
    знч МассивДеталей = ПолученноеЗначение как Массив<Детали.Ссылка>
    
    для Элемент из МассивДеталей

        знч НоваяСтрока = Объект.Состав.ДобавитьНовый()
        НоваяСтрока.Деталь = Элемент
        НоваяСтрока.НомерПоИнструкции = ПолучитьНомерПоИнструкции(НоваяСтрока.Деталь)
        
    ; 
;

метод ОбработчикПрикрепитьФото(Команда: ОбычнаяКоманда)

    
    //ФормаПросмотраМедиа.ОткрытьВМодальномОкне(МассивОбъектов = Объект.МассивФайлов)
    ФормаГалереяКартинок.ОткрытьВМодальномОкне(МассивФайлов = Объект.МассивФайлов)
    
;



метод ПолучитьСтроковоеПредставлениеСтоимости(): неизвестно
    
    пер ВалютаПредставление = ""
    
    если Объект.Валюта != Неопределено
     
        ВалютаПредставление = Объект.Валюта.ВСтроку()
        
    ;
    
    возврат Объект.Стоимость.ВСтроку() + " " + ВалютаПредставление 
;

метод ЭтоНеНоваяЗаявка(): Булево
    
    пер Рез = Истина
    
    если Объект.Статус == СтатусРекламации.Новая или Объект.Статус == СтатусРекламации.ОтмененоКлиентом
        
        Рез = Ложь
    
    ;
    
    возврат Рез
;

метод ПересчитатьСтоимость()
    
    пер ИтоговаяСтоимость = 0
    
    если Объект.Платная 
    
            для СтрокаСостав из Объект.Состав
        
            СтрокаСостав.Стоимость = СтрокаСостав.Количество * СтрокаСостав.Цена
            
            ИтоговаяСтоимость = ИтоговаяСтоимость + СтрокаСостав.Стоимость 

        ;
    ;

    Объект.Стоимость = ИтоговаяСтоимость
;

    

метод ОбработчикЗапросЦены(Команда: ПереключаемаяКоманда)
    
    Объект.ЗапросЦены = Команда.Активна
    
    если Объект.ЗапросЦены
    
        Объект.Платная = Истина

        пер КомандаПлатно = ДополнительныеКоманды.Элементы[0] как ПереключаемаяКоманда
        КомандаПлатно.Активна = Истина
        
    ;
;

@НаСервере @ДоступноСКлиента
статический метод ВыбиратьПокупателяИзСправочника(Клиент: Клиенты.Ссылка): Булево
 
    знч Запрос = новый ПроизвольныйЗапрос(
        "ВЫБРАТЬ
            *
         ИЗ 
            Клиенты
        ГДЕ
            Ссылка == &Клиент")
 
    
    пер Рез = Истина
    
    Запрос.УстановитьПараметр("Клиент", Клиент)
    
    для СтрокаРезультата из Запрос.Выполнить()
        
        Рез = СтрокаРезультата.ВводПокупателейСтрокой    
    ;
    
    возврат Рез
    
;

метод ОткрытьПрикрепленныеФото(Команда: ОбычнаяКоманда)
    
    ФормаГалереяКартинок.ОткрытьВМодальномОкне(МассивФайлов = Объект.МассивФайлов)
    
;

метод КоллекцияНадписьПриНажатии(Источник: Надпись, Событие: СобытиеПриНажатии)
    
    Событие.СтандартнаяОбработка = Ложь

    знч ВыбраннаяКоллекция = КоллекцииФормаСписка.ОткрытьВМодальномОкне()

    если не ВыбраннаяКоллекция == Неопределено
        если Объект.Коллекция != ВыбраннаяКоллекция
            Объект.Изделие = Неопределено

            Объект.Состав.Очистить()
        ;

        Объект.Коллекция = ВыбраннаяКоллекция
    ;
    
    
;

метод НадписьИзделиеПриНажатии(Источник: Надпись, Событие: СобытиеПриНажатии)
 
    Событие.СтандартнаяОбработка = Ложь

    если Объект.Коллекция == Неопределено
        возврат
    ;

    знч ВыбраннаяНоменклатура = ФормаВыбораНоменклатура.ОткрытьВМодальномОкне(Коллекция = Объект.Коллекция)

    если не ВыбраннаяНоменклатура == Неопределено
        если Объект.Изделие != ВыбраннаяНоменклатура
            Объект.Состав.Очистить()
        ;

        Объект.Изделие = ВыбраннаяНоменклатура
    ;

    
;

метод ВыводКоллекции(): Строка|Коллекции.Ссылка
    
    если Объект.Коллекция == Неопределено
        
        возврат "<Укажите коллекцию>"
        
    иначе
        
        возврат Объект.Коллекция
        
    ;
    
;

метод ВыводИзделия(): Строка|Номенкатура.Ссылка
    
    если Объект.Изделие == Неопределено
        
        возврат "<Укажите изделие>"

    иначе
        
        возврат Объект.Изделие
    ;
;

метод ДатаПроизводстваПриИзменении(Источник: ПолеВвода<Дата?>, Событие: СобытиеПриИзменении<Дата?>)
    
    Компоненты.ДатаПроизводства.РезультатПроверкиДанных = РезультатПроверкиДанных.Отсутствует    
    
;