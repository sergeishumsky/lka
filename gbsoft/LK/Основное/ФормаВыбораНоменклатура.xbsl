@Обработчик
метод ПослеСоздания()
    
    
    Компоненты.ОсновнаяТаблица.Источник.Параметры.Добавить(новый ПараметрДинамическогоСписка(Коллекция, "Коллекция"))

;

метод ПриНажатииСтроки(Источник: Список<ДинамическийСписок>, Событие: СобытиеСДанными<СтрокаСписка<СтрокаДинамическогоСписка>>)
    
    знч НоменклатураСсылка = Событие.Данные.ДанныеСтроки.Данные["Ссылка"] как Номенкатура.Ссылка?
 
    Закрыть(НоменклатураСсылка)
    
;

метод ПриЧтенииНастроекТаблицы(Источник: Список<ДинамическийСписок>, Событие: СобытиеСДанными<Массив<СохраненнаяНастройкаСписка>>)

    

;