конст ИМЯ_ФАЙЛА_ВЫГРУЗКИ = "Номенклатура.xls"

метод ВыгрузитьВЭксель(Команда: ОбычнаяКоманда)

    знч ДвоичнаяСсылка = РекламацииКлиентИСервер.ВыгрузитьВсюНоменклатуруВExcel()
   
    ВыгрузкаФайлов.НачатьВыгрузку(ДвоичнаяСсылка, ИМЯ_ФАЙЛА_ВЫГРУЗКИ)    
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьМассивНоменклатуры(Начало: Строка, Конец: Строка): Массив<Номенкатура.Ссылка>
 
    знч Запрос = Запрос{ВЫБРАТЬ
        Номенкатура.Ссылка КАК Ссылка,
        Номенкатура.Представление КАК Представление
    ИЗ
        Номенкатура КАК Номенкатура
    ГДЕ
        Номенкатура.Код >= %Начало
        И Номенкатура.Код < %Конец
    }
    
    исп Результат = Запрос.Выполнить()
    
    знч Массив = новый Массив<Номенкатура.Ссылка>()
    
    для СтрокаРезультата из Результат
        Массив.Добавить(СтрокаРезультата.Ссылка)        
    ;
    
    возврат Массив
    
;

метод ВыгрузитьДетали(Команда: ОбычнаяКоманда)

    пер МассивНоменклатуры = ПолучитьМассивНоменклатуры("00000000000", "00000002000")

    пер ДвоичнаяСсылка = РекламацииКлиентИСервер.ВыгрузитьВсеДеталиСНоменклатуройВExcel(МассивНоменклатуры)
    
    ВыгрузкаФайлов.НачатьВыгрузку(ДвоичнаяСсылка, "0000.xls")

    МассивНоменклатуры = ПолучитьМассивНоменклатуры("00000002000", "00000004000")

    ДвоичнаяСсылка = РекламацииКлиентИСервер.ВыгрузитьВсеДеталиСНоменклатуройВExcel(МассивНоменклатуры)

    ВыгрузкаФайлов.НачатьВыгрузку(ДвоичнаяСсылка, "2000.xls")    

    МассивНоменклатуры = ПолучитьМассивНоменклатуры("00000004000", "00000006000")

    ДвоичнаяСсылка = РекламацииКлиентИСервер.ВыгрузитьВсеДеталиСНоменклатуройВExcel(МассивНоменклатуры)

    ВыгрузкаФайлов.НачатьВыгрузку(ДвоичнаяСсылка, "4000.xls")    

    МассивНоменклатуры = ПолучитьМассивНоменклатуры("00000006000", "00000008000")

    ДвоичнаяСсылка = РекламацииКлиентИСервер.ВыгрузитьВсеДеталиСНоменклатуройВExcel(МассивНоменклатуры)

    ВыгрузкаФайлов.НачатьВыгрузку(ДвоичнаяСсылка, "8000.xls")    

;

