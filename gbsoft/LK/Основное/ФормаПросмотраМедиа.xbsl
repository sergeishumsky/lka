@Обработчик
метод ПослеСоздания()
    
       
    ПодключитьОбработчикТаймера(&ОбновитьКартинку, 250мс, Истина)
    
    
;

метод ОбновитьКартинку()
    
    если МассивОбъектов.Размер() != 0
    
        Компоненты.Картинка.Изображение = МассивОбъектов[0]
        НомерТекущейКартинки = 1
    ;
        
;

метод ПриИзменении(Источник: ВыборФайлов, Событие: СобытиеПриИзменении<ЧитаемыйМассив<ВыбранныйФайл>>)
    
    знч Файл = Событие.НовоеЗначение[0]
    
    знч Изображение = ЗагрузкаФайлов.НачатьЗагрузку(Файл).ПолучитьРезультат()
    
    Компоненты.Картинка.Изображение = Изображение
    
    МассивОбъектов.Добавить(Изображение)
    
    НомерТекущейКартинки = МассивОбъектов.Размер()
    
;


метод КнопкаВлевоПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    
    если НомерТекущейКартинки == 0 
    
        возврат
        
    ;
    
    НомерТекущейКартинки = НомерТекущейКартинки - 1
    если НомерТекущейКартинки == 0 
    
        НомерТекущейКартинки = МассивОбъектов.Размер()
    
    ;
    
    Компоненты.Картинка.Изображение = МассивОбъектов[НомерТекущейКартинки - 1]

;

метод КнопкаВправоПриНажатии(Источник: Компонент, Событие: СобытиеКомпонента)
    
    если НомерТекущейКартинки == 0 
    
        возврат
        
    ;

    НомерТекущейКартинки = НомерТекущейКартинки + 1
    если НомерТекущейКартинки > МассивОбъектов.Размер()
    
        НомерТекущейКартинки = 1
    
    ;

    Компоненты.Картинка.Изображение = МассивОбъектов[НомерТекущейКартинки - 1]
    
;

метод КнопкаУдалитьПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    // TODO Вставить содержимое обработчика
;

метод КнопкаСохранитьПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)

    Закрыть(МассивОбъектов)
    
;