импорт ПечатьДокументов

метод ПриИзменении(Источник: ВыборФайлов, Событие: СобытиеПриИзменении<ЧитаемыйМассив<ВыбранныйФайл>>)
    
    
    знч МассивЗначений = Событие.НовоеЗначение
    
    для Файл из МассивЗначений 
        
        знч Документ = ЗагрузкаФайлов.НачатьЗагрузку(Файл).ПолучитьРезультат()    
        Объект.СканДокумента = Документ  
    ;
    
;

метод ПечатьРеестра(Команда: ОбычнаяКоманда)

    ПечатьДокументовКлиент.ОткрытьФормуДокумента(РекламацииКлиентИСервер.ВыгрузитьРеестрВPDF(Объект.Клиент, Объект.Дата), "Реестр рекламаций")
    
;

метод ПечатьИПодписьРеестра(Команда: ОбычнаяКоманда)
    
    знч ДвоичныйОбъектСсылка = РекламацииКлиентИСервер.ВыгрузитьРеестрВPDF(Объект.Клиент, Объект.Дата, Истина)
    
    Объект.СканДокумента = ДвоичныйОбъектСсылка
    
;

@НаСервере @ДоступноСКлиента
статический метод ЕстьПрефикс(Клиент: Клиенты.Ссылка): Булево
    
    знч Префикс = Клиент.ЗагрузитьОбъект().КодФаксимиле
    
    если Префикс.Пусто() 
    
        возврат Ложь
        
    ;
    
    возврат Истина   

;


@Обработчик
метод ПослеЧтения()
    
    Компоненты.Клиент.ОткрытьЗначение.Видимость = Ложь

;