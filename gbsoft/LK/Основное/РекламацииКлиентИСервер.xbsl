@ВПодсистеме
@НаСервере @ДоступноСКлиента
метод ВыгрузитьЗаявкиКлиентаВExcel(Клиент: Клиенты.Ссылка, ДатаС: ДатаВремя?, ДатаПо: ДатаВремя?): ДвоичныйОбъект.Ссылка
    знч ЗаявкиКлиента = Рекламация.ПолучитьРекламацииКлиента(Клиент, ДатаС, ДатаПо)
    возврат ВыгрузитьЗаявкиВExcel(ЗаявкиКлиента)
;

@ВПодсистеме
@НаСервере @ДоступноСКлиента
метод ВыгрузитьВсеЗаявкиВExcel(): ДвоичныйОбъект.Ссылка
    знч ВсеЗаявки = Рекламация.ПолучитьВсеРекламации()
    возврат ВыгрузитьЗаявкиВExcel(ВсеЗаявки)
;


@ВПодсистеме
@НаСервере @ДоступноСКлиента
метод ВыгрузитьНоменклатуруВExcel(): ДвоичныйОбъект.Ссылка
    возврат ВыгрузитьВсюНоменклатуруВExcel()
;

@ВПодсистеме
@НаСервере @ДоступноСКлиента
метод ВыгрузитьЗаявкиВExcel(Заявки: ЧитаемыйМассив<Рекламация.Ссылка>): ДвоичныйОбъект.Ссылка
    знч МакетДанные = Ресурс{МакетыПечатныеФормы/МакетЗаказы.mxl}.ОткрытьПотокЧтения()
    пер Макет = ТабличныйДокумент.Прочитать(МакетДанные)
    МакетДанные.Закрыть()
    
    знч ИтоговыйТабличныйДокумент = новый ТабличныйДокумент()
    знч Писатель = ИтоговыйТабличныйДокумент.Запись
    
    знч ЗапросДанных = новый ПроизвольныйЗапрос(
        "ВЫБРАТЬ
            Владелец.Дата КАК Дата,
            Владелец.Номер КАК НомерЗаявки,
            Владелец.НомерКлиента КАК ЗаявкаКлиента,
            Владелец.Покупатель КАК Клиент,
            Владелец.Покупатель КАК Заказчик,
            Владелец.Примечание КАК Примечание,
            Владелец.Изделие КАК Изделие,
            Количество КАК Количество,
            НомерСтроки КАК НомерВЗаявке,
            Деталь КАК Деталь,
            Владелец.ВнешнийИдентификатор КАК ВнешнийИдентификатор,
            НомерПоИнструкции КАК НомерДетали
        ИЗ
            Рекламация.Состав
        ГДЕ
            Владелец.Ссылка В (&МассивСсылок)")
    
    знч ШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы")
    знч СтрокаТаблицы = Макет.ПолучитьОбласть("ДанныеТаблицы")
    
    Писатель.ВывестиВертикально(ШапкаТаблицы)
    
    пер Счетчик = 0
    знч РазмерПакета = 500
    
    пока Счетчик < Заявки.Размер()
        знч ВерхняяГраница = Мин(Счетчик + РазмерПакета, Заявки.Размер())
        знч ПакетСсылок = Заявки.ПодМассив(Счетчик, ВерхняяГраница)
        ЗапросДанных.УстановитьПараметр("МассивСсылок", ПакетСсылок)
        
        исп Данные = ЗапросДанных.Выполнить()
        
        для ДанныеРекламации из Данные
            знч ОбластьСтроки = СтрокаТаблицы.ВВыводимуюОбласть()
            
            знч ПараметрыОбласти: Соответствие<Строка, Объект> = {
                "Дата": ДанныеРекламации.Дата.Представление(),
                "НомерЗаявки": ДанныеРекламации.НомерЗаявки.Представление(),
                "НомерВЗаявке": ДанныеРекламации.НомерВЗаявке.Представление(),
                "ЗаявкаЗаказчика": ДанныеРекламации.ЗаявкаКлиента.Представление(),
                "Клиент": ДанныеРекламации.Клиент.Представление(),
                "Заказчик": ДанныеРекламации.Заказчик.Представление(),
                "Количество": ДанныеРекламации.Количество.Представление(),
                "Изделие": ДанныеРекламации.Изделие.Представление(),
                "Деталь": ДанныеРекламации.Деталь.Представление(),
                "НомерПачки": ДанныеРекламации.Деталь.ЗагрузитьОбъект().Пачка.Представление(),
                "НомерДетали": ДанныеРекламации.НомерДетали.Представление(),
                "Примечание": ДанныеРекламации.Примечание.Представление()
            }
            
            ОбластьСтроки.ЗаполнитьПараметры(ПараметрыОбласти)
            Писатель.ВывестиВертикально(ОбластьСтроки)
            
            Счетчик += 1
        ;
    ;
    
    знч БайтыТаблицы = ИтоговыйТабличныйДокумент.ЭкспортироватьВБайты(ФорматЭкспортаТабличногоДокумента.Xls)
    знч СвойстваДвоичногоОбъекта = новый ДвоичныйОбъект.Свойства("ВыгрузкаЗадач").Временные()
    знч Результат = ОбъектноеХранилище.Загрузить(ИмяФайла = Неопределено, Байты = БайтыТаблицы, Свойства = СвойстваДвоичногоОбъекта)
    
    возврат Результат.Ссылка
;

@ВПодсистеме
@НаСервере @ДоступноСКлиента
метод ВыгрузитьВсюНоменклатуруВExcel(): ДвоичныйОбъект.Ссылка
    знч МакетДанные = Ресурс{МакетыПечатныеФормы/МакетНоменклатура.mxl}.ОткрытьПотокЧтения()
    пер Макет = ТабличныйДокумент.Прочитать(МакетДанные)
    МакетДанные.Закрыть()
    
    знч ИтоговыйТабличныйДокумент = новый ТабличныйДокумент()
    знч Писатель = ИтоговыйТабличныйДокумент.Запись
    
    знч ЗапросДанных = новый ПроизвольныйЗапрос(
        "ВЫБРАТЬ
            Наименование КАК Наименование,
            ВнешнийИдентификатор КАК ВнешнийИдентификатор,
            Код КАК Код
        ИЗ
            Номенкатура
        ГДЕ
            Ссылка В (&МассивСсылок)")
        
    
    знч ШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы")
    знч СтрокаТаблицы = Макет.ПолучитьОбласть("ДанныеТаблицы")
    
    знч Заявки = Номенкатура.ПолучитьВсюНоменклатуру()
    
    Писатель.ВывестиВертикально(ШапкаТаблицы)
    
    пер Счетчик = 0
    знч РазмерПакета = 5000
    
    пока Счетчик < Заявки.Размер()
        знч ВерхняяГраница = Мин(Счетчик + РазмерПакета, Заявки.Размер())
        
        знч ПакетСсылок = Заявки.ПодМассив(Счетчик, ВерхняяГраница)
        ЗапросДанных.УстановитьПараметр("МассивСсылок", ПакетСсылок)
        
        исп Данные = ЗапросДанных.Выполнить()
        
        для ДанныеРекламации из Данные
            знч ОбластьСтроки = СтрокаТаблицы.ВВыводимуюОбласть()
            
            знч ПараметрыОбласти: Соответствие<Строка, Объект> = {
                "Наименование": ДанныеРекламации.Наименование.Представление(),
                "ВнешнийИдентификатор": ДанныеРекламации.ВнешнийИдентификатор.Представление(),
                "Код": ДанныеРекламации.Код.Представление()
            }
            
            ОбластьСтроки.ЗаполнитьПараметры(ПараметрыОбласти)
            Писатель.ВывестиВертикально(ОбластьСтроки)
            
            Счетчик += 1
        ;
    ;
    
    знч БайтыТаблицы = ИтоговыйТабличныйДокумент.ЭкспортироватьВБайты(ФорматЭкспортаТабличногоДокумента.Xls)
    знч СвойстваДвоичногоОбъекта = новый ДвоичныйОбъект.Свойства("ВыгрузкаЗадач").Временные()
    знч Результат = ОбъектноеХранилище.Загрузить(ИмяФайла = Неопределено, Байты = БайтыТаблицы, Свойства = СвойстваДвоичногоОбъекта)
    
    возврат Результат.Ссылка
;

@ВПодсистеме
@НаСервере @ДоступноСКлиента
метод ВыгрузитьРеестрВPDF(Клиент: Клиенты.Ссылка, ДатаРеестра: Дата, Автоподпись: Булево = Ложь): ДвоичныйОбъект.Ссылка
    
    пер МакетДанные = Ресурс{МакетыПечатныеФормы/РеестрРекламаций_Ландшафт.mxl}.ОткрытьПотокЧтения()
    
    если Автоподпись 
    
        знч КодФаксимиле = Клиент.ЗагрузитьОбъект().КодФаксимиле
        
        если КодФаксимиле == "АБ"
            
            МакетДанные = Ресурс{МакетыПечатныеФормы/РеестрРекламаций_ФаксимилеАБ.mxl}.ОткрытьПотокЧтения()
            
        ;
        
    ;
    
    //знч МакетДанные = Ресурс{МакетыПечатныеФормы/РеестрРекламаций_Ландшафт.mxl}.ОткрытьПотокЧтения()
    
    пер Макет = ТабличныйДокумент.Прочитать(МакетДанные)
    МакетДанные.Закрыть()
    
    знч ИтоговыйТабличныйДокумент = новый ТабличныйДокумент()
    знч Писатель = ИтоговыйТабличныйДокумент.Запись
    знч КлиентСтрокой = не Клиент.ЗагрузитьОбъект().ВводПокупателейСтрокой
    
    знч ЗапросДанных = Запрос{
        ВЫБРАТЬ
            Состав.Деталь КАК Деталь,
            Состав.Количество КАК Количество,
            Состав.НомерПоИнструкции КАК НомерПоИнструкции,
            Состав.Причина КАК Причина,
            ВЫБОР КОГДА %КлиентСтрокой ТОГДА Рекламация.ПокупательСтрокой ИНАЧЕ Рекламация.Покупатель КОНЕЦ КАК Контрагент,
            Рекламация.Изделие КАК Изделие,
            Рекламация.Номер КАК НомерЗаявки,
            Рекламация.Статус КАК Статус,
            Рекламация.Примечание КАК Примечание,
            Рекламация.НомерКлиента КАК НомерКлиента
             
        ИЗ 
            Рекламация.Состав КАК Состав
        ПРАВОЕ СОЕДИНЕНИЕ Рекламация КАК Рекламация
            ПО Состав.Владелец == Рекламация.Ссылка
        ГДЕ
            Рекламация.Клиент == %Клиент И Рекламация.Дата.Дата() == %ДатаРеестра И Рекламация.Платная == Ложь
    }
    
    знч ШапкаТаблицы = Макет.ПолучитьОбласть("Шапка")
    знч СтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаТаблицы")
    знч ПодвалТаблицы = Макет.ПолучитьОбласть("Подвал")
    
    знч ОбластьШапка = ШапкаТаблицы.ВВыводимуюОбласть()
    
    знч НаименованиеКлиентаДляРеестра = Клиент.ЗагрузитьОбъект().НаименованиеДляРеестра
    
    если НаименованиеКлиентаДляРеестра.Пусто() 
    
        ОбластьШапка.УстановитьПараметр("КлиентНаименованиеПолное", Клиент.Представление())
        
    иначе
        
        ОбластьШапка.УстановитьПараметр("КлиентНаименованиеПолное", НаименованиеКлиентаДляРеестра)
    
    ;
    
    ОбластьШапка.УстановитьПараметр("УНПКлиента", Клиент.ЗагрузитьОбъект().УНП)
    ОбластьШапка.УстановитьПараметр("НомерРеестра", ДатаРеестра.Представление().Заменить(".", ""))
    ОбластьШапка.УстановитьПараметр("ДатаРеестра", ДатаРеестра.Представление())
    
    пер ПоследниеСтроки = новый Массив<ОбластьТабличногоДокумента>()
    
    ПоследниеСтроки.Добавить(ПодвалТаблицы)
    ПоследниеСтроки.Добавить(ПодвалТаблицы)
    
    
    Писатель.ВывестиВертикально(ОбластьШапка)
    
    пер Счетчик = 0

    исп Данные = ЗапросДанных.Выполнить()
    
    для ДанныеРекламации из Данные
        
        если ДанныеРекламации.Статус == СтатусРекламации.Отказ или ДанныеРекламации.Статус == СтатусРекламации.ОтмененоКлиентом
            продолжить   
        ;
        
        знч ОбластьСтроки = СтрокаТаблицы.ВВыводимуюОбласть()
        
        знч ПараметрыОбласти: Соответствие<Строка, Объект> = {
            "Деталь": ДанныеРекламации.Деталь.Представление(),
            "Изделие": ДанныеРекламации.Изделие.Представление(),
            "НомерЗаявки": ДанныеРекламации.НомерЗаявки.Представление(),
            "НомерКлиента": ДанныеРекламации.НомерКлиента.Представление(),
            "Причина": ДанныеРекламации.Причина.Представление(),
            "Контрагент": ДанныеРекламации.Контрагент.Представление(),
            "Количество": ДанныеРекламации.Количество.Представление(),
            "НомерПоИнструкции": ДанныеРекламации.НомерПоИнструкции.Представление()
        }
        
        Счетчик += 1
        
        ОбластьСтроки.ЗаполнитьПараметры(ПараметрыОбласти)
        
        если ДанныеРекламации.Деталь != Null
        
            ОбластьСтроки.УстановитьПараметр("ТипДетали", (ДанныеРекламации.Деталь как Детали.Ссылка).ЗагрузитьОбъект().ТипДетали.Представление())    
            
        иначе
            
            ОбластьСтроки.УстановитьПараметр("Деталь", ДанныеРекламации.Примечание)
            ОбластьСтроки.УстановитьПараметр("НомерПоИнструкции", "")
        ;
        
        ОбластьСтроки.УстановитьПараметр("Номер", Счетчик)
        
        
        если Автоподпись и не Писатель.ПроверитьВместимостьПоВертикали(ПоследниеСтроки)
            
            Писатель.ВывестиВертикально(ОбластьСтроки)
            Писатель.ВывестиГоризонтальныйРазрывСтраницы()
            //Писатель.ВывестиВертикально(ОбластьШапка)
            
        иначе
        
            Писатель.ВывестиВертикально(ОбластьСтроки)
            
        ;
        
        
    ;
    
    Писатель.ВывестиВертикально(ПодвалТаблицы)
    
    ИтоговыйТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Альбомная
    
    
    знч БайтыТаблицы = ИтоговыйТабличныйДокумент.ЭкспортироватьВБайты(ФорматЭкспортаТабличногоДокумента.Pdf)
    знч СвойстваДвоичногоОбъекта = новый ДвоичныйОбъект.Свойства("ВыгрузкаЗадач").Временные()
    
    знч Результат = ОбъектноеХранилище.Загрузить(ИмяФайла = Неопределено, Байты = БайтыТаблицы, Свойства = СвойстваДвоичногоОбъекта)
    
    МакетДанные.Закрыть()
    
    возврат Результат.Ссылка
;


@ВПодсистеме
@НаСервере @ДоступноСКлиента
метод ВыгрузитьВсеДеталиВExcel(): ДвоичныйОбъект.Ссылка
    знч МакетДанные = Ресурс{МакетыПечатныеФормы/МакетНоменклатура.mxl}.ОткрытьПотокЧтения()
    пер Макет = ТабличныйДокумент.Прочитать(МакетДанные)
    МакетДанные.Закрыть()
    
    знч ИтоговыйТабличныйДокумент = новый ТабличныйДокумент()
    знч Писатель = ИтоговыйТабличныйДокумент.Запись
    
    знч ЗапросДанных = новый ПроизвольныйЗапрос(
        "ВЫБРАТЬ
            Наименование КАК Наименование,
            ВнешнийИдентификатор КАК ВнешнийИдентификатор,
            НомерПоИнструкции КАК Код
        ИЗ
            Детали
        ГДЕ
            Ссылка В (&МассивСсылок)")
        
    
    знч ШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы")
    знч СтрокаТаблицы = Макет.ПолучитьОбласть("ДанныеТаблицы")
    
    знч Заявки = Номенкатура.ПолучитьВсеДетали1()
    
    Писатель.ВывестиВертикально(ШапкаТаблицы)
    
    пер Счетчик = 0
    знч РазмерПакета = 5000
    
    пока Счетчик < Заявки.Размер()
        знч ВерхняяГраница = Мин(Счетчик + РазмерПакета, Заявки.Размер())
        
        знч ПакетСсылок = Заявки.ПодМассив(Счетчик, ВерхняяГраница)
        ЗапросДанных.УстановитьПараметр("МассивСсылок", ПакетСсылок)
        
        исп Данные = ЗапросДанных.Выполнить()
        
        для ДанныеРекламации из Данные
            знч ОбластьСтроки = СтрокаТаблицы.ВВыводимуюОбласть()
            
            знч ПараметрыОбласти: Соответствие<Строка, Объект> = {
                "Наименование": ДанныеРекламации.Наименование.Представление(),
                "ВнешнийИдентификатор": ДанныеРекламации.ВнешнийИдентификатор.Представление(),
                "Код": ДанныеРекламации.Код.Представление()
            }
            
            ОбластьСтроки.ЗаполнитьПараметры(ПараметрыОбласти)
            Писатель.ВывестиВертикально(ОбластьСтроки)
            
            Счетчик += 1
        ;
    ;
    
    знч БайтыТаблицы = ИтоговыйТабличныйДокумент.ЭкспортироватьВБайты(ФорматЭкспортаТабличногоДокумента.Xls)
    знч СвойстваДвоичногоОбъекта = новый ДвоичныйОбъект.Свойства("ВыгрузкаЗадач").Временные()
    знч Результат = ОбъектноеХранилище.Загрузить(ИмяФайла = Неопределено, Байты = БайтыТаблицы, Свойства = СвойстваДвоичногоОбъекта)
    
    возврат Результат.Ссылка
;

@ВПодсистеме
@НаСервере @ДоступноСКлиента
метод ВыгрузитьВсеДеталиСНоменклатуройВExcel(ПакетСсылок:Массив<Номенкатура.Ссылка>): ДвоичныйОбъект.Ссылка
    знч МакетДанные = Ресурс{МакетДеталиПродукцияДубли.mxl}.ОткрытьПотокЧтения()
    пер Макет = ТабличныйДокумент.Прочитать(МакетДанные)
    МакетДанные.Закрыть()

    знч ИтоговыйТабличныйДокумент = новый ТабличныйДокумент()
    знч Писатель = ИтоговыйТабличныйДокумент.Запись

    знч ЗапросДанных = новый ПроизвольныйЗапрос(
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
            Детали.Владелец.Наименование КАК НаименованиеПродукции,
            Детали.Владелец.ПровереннаяПозиция КАК Дубль,
            Детали.Владелец.Код КАК КодПродукции,
            Детали.Владелец.ВнешнийИдентификатор КАК ВнешнийИдентификаторПродукции,
            Деталь.Наименование КАК Наименование,
            Деталь.ВнешнийИдентификатор КАК ВнешнийИдентификатор
        ИЗ
            Номенкатура.СписокДеталей КАК Детали
        ГДЕ
            Владелец В (&МассивСсылок)")

    знч ШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы")
    знч СтрокаТаблицы = Макет.ПолучитьОбласть("ДанныеТаблицы")

    Писатель.ВывестиВертикально(ШапкаТаблицы)

    ЗапросДанных.УстановитьПараметр("МассивСсылок", ПакетСсылок)

    исп Данные = ЗапросДанных.Выполнить()

    для ДанныеРекламации из Данные
        знч ОбластьСтроки = СтрокаТаблицы.ВВыводимуюОбласть()

        знч ПараметрыОбласти: Соответствие<Строка, Объект> = {
            "Наименование": ДанныеРекламации.Наименование.Представление(),
            "ВнешнийИдентификатор": ДанныеРекламации.ВнешнийИдентификатор.Представление(),
            "НаименованиеПродукции": ДанныеРекламации.НаименованиеПродукции.Представление(),
            "ВнешнийИдентификаторПродукции": ДанныеРекламации.ВнешнийИдентификаторПродукции.Представление(),
            "Дубль": ДанныеРекламации.Дубль.Представление(),
            "КодПродукции": ДанныеРекламации.КодПродукции.Представление()
        }

        ОбластьСтроки.ЗаполнитьПараметры(ПараметрыОбласти)
        Писатель.ВывестиВертикально(ОбластьСтроки)

    ;

    знч БайтыТаблицы = ИтоговыйТабличныйДокумент.ЭкспортироватьВБайты(ФорматЭкспортаТабличногоДокумента.Xls)
    знч СвойстваДвоичногоОбъекта = новый ДвоичныйОбъект.Свойства("ВыгрузкаЗадач").Временные()
    знч Результат = ОбъектноеХранилище.Загрузить(ИмяФайла = Неопределено, Байты = БайтыТаблицы, Свойства = СвойстваДвоичногоОбъекта)

    возврат Результат.Ссылка
;


@ВПодсистеме
@НаСервере @ДоступноСКлиента
метод ВыгрузитьВсеДеталиВExcel2(): ДвоичныйОбъект.Ссылка
    знч МакетДанные = Ресурс{МакетыПечатныеФормы/МакетНоменклатура.mxl}.ОткрытьПотокЧтения()
    пер Макет = ТабличныйДокумент.Прочитать(МакетДанные)
    МакетДанные.Закрыть()

    знч ИтоговыйТабличныйДокумент = новый ТабличныйДокумент()
    знч Писатель = ИтоговыйТабличныйДокумент.Запись

    знч ЗапросДанных = новый ПроизвольныйЗапрос(
        "ВЫБРАТЬ
            Наименование КАК Наименование,
            ВнешнийИдентификатор КАК ВнешнийИдентификатор,
            НомерПоИнструкции КАК Код
        ИЗ
            Детали
        ГДЕ
            Ссылка В (&МассивСсылок)")

    знч ШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы")
    знч СтрокаТаблицы = Макет.ПолучитьОбласть("ДанныеТаблицы")

    знч Заявки = Номенкатура.ПолучитьВсеДетали2()

    Писатель.ВывестиВертикально(ШапкаТаблицы)

    пер Счетчик = 0
    знч РазмерПакета = 5000

    пока Счетчик < Заявки.Размер()
        знч ВерхняяГраница = Мин(Счетчик + РазмерПакета, Заявки.Размер())

        знч ПакетСсылок = Заявки.ПодМассив(Счетчик, ВерхняяГраница)
        ЗапросДанных.УстановитьПараметр("МассивСсылок", ПакетСсылок)

        исп Данные = ЗапросДанных.Выполнить()

        для ДанныеРекламации из Данные
            знч ОбластьСтроки = СтрокаТаблицы.ВВыводимуюОбласть()

            знч ПараметрыОбласти: Соответствие<Строка, Объект> = {
                "Наименование": ДанныеРекламации.Наименование.Представление(),
                "ВнешнийИдентификатор": ДанныеРекламации.ВнешнийИдентификатор.Представление(),
                "Код": ДанныеРекламации.Код.Представление()
            }

            ОбластьСтроки.ЗаполнитьПараметры(ПараметрыОбласти)
            Писатель.ВывестиВертикально(ОбластьСтроки)

            Счетчик += 1
        ;
    ;

    знч БайтыТаблицы = ИтоговыйТабличныйДокумент.ЭкспортироватьВБайты(ФорматЭкспортаТабличногоДокумента.Xls)
    знч СвойстваДвоичногоОбъекта = новый ДвоичныйОбъект.Свойства("ВыгрузкаЗадач").Временные()
    знч Результат = ОбъектноеХранилище.Загрузить(ИмяФайла = Неопределено, Байты = БайтыТаблицы, Свойства = СвойстваДвоичногоОбъекта)

    возврат Результат.Ссылка
;


